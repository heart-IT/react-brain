---
// "Technical Precision" theme — the navigation shell.
// Top bar = brand · search field (⌘K / Ctrl-K focuses it) · four task sections
// (Explore · Doctor · Learn · Evidence) · GitHub. Left sidebar = the encyclopedia
// groups (Explore), with Tools + About as quieter secondary lists. Below 1024px the
// sidebar becomes one compact <details> menu; below 640px the top-bar section links
// fold into that menu too, so nothing can overflow a 320px viewport.
// Every number/date printed here comes from siteMeta() — never typed into copy.
const HOME_TITLE = 'react-brain — React & React Native engineering decisions, with receipts';
const { title = null, description = 'Engineering decisions for React & React Native, with receipts — context-keyed recommendations with dated primary sources and graded forecasts.', activeGroup = null } = Astro.props;
import { GITHUB, href, siteMeta, corpus, BASE } from '../lib/corpus.js';
import interUrl from '../assets/fonts/Inter.woff2?url';
import monoUrl from '../assets/fonts/JetBrainsMono.woff2?url';
const fontFaces = [
  ['Inter', interUrl, '100 900'],
  ['JetBrains Mono', monoUrl, '100 800'],
].map(([fam, url, w]) => `@font-face{font-family:"${fam}";src:url(${url}) format("woff2");font-weight:${w};font-display:swap;}`).join('');
const meta = siteMeta();
const { groups } = corpus();
const path = Astro.url.pathname;
// Pagefind indexes only <main> (data-pagefind-body) so header/sidebar/footer words
// don't match every page; the 404 page is left out of the index entirely.
const is404 = /\/404(\.html)?\/?$/.test(path);

// "<Page> · react-brain" everywhere; legacy "react-brain — page" props are normalized
// so every page gets the same pattern without each page restating the brand.
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const pageTitle = title == null ? HOME_TITLE
  : title.startsWith('react-brain — ') ? `${cap(title.slice('react-brain — '.length))} · react-brain`
  : title.includes('react-brain') ? title : `${title} · react-brain`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(href('og.png'), Astro.site).href;

// ── the four task sections; a section is active for every route it owns ──
const under = (p) => path.startsWith(href(p));
const SECTIONS = [
  { to: 'entries/', label: 'Explore', owns: ['entries/', 'libraries/', 'stack/', 'decide/'] },
  { to: 'doctor/', label: 'Doctor', owns: ['doctor/'] },
  { to: 'reading/', label: 'Learn', owns: ['reading/', 'newsletter/'] },
  { to: 'scorecard/', label: 'Evidence', owns: ['scorecard/', 'census/', 'benchmark/', 'methodology/', 'changelog/', 'architecture/', 'roadmap/'] },
];
const activeSection = SECTIONS.find((s) => s.owns.some(under))?.label ?? null;

const groupLabel = (g) => g.label.split(' — ')[0].split(' (')[0];
const toolLinks = [
  { to: 'libraries/', label: 'libraries' },
  { to: 'stack/', label: 'stack composer' },
  { to: 'decide/', label: 'decision records' },
  { to: 'census/', label: 'census' },
  { to: 'benchmark/', label: 'staleness bench' },
];
const aboutLinks = [
  { to: 'methodology/', label: 'methodology' },
  { to: 'architecture/', label: 'architecture' },
  { to: 'changelog/', label: 'changelog' },
  { to: 'roadmap/', label: 'roadmap' },
  { to: 'newsletter/', label: 'newsletter' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="react-brain" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" type="application/xml" href={href('sitemap.xml')} />
  <link rel="icon" type="image/png" sizes="32x32" href={href('favicon-32.png')} />
  <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
  <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
  <style set:html={fontFaces}></style>
  <script defer src={href('console.js')}></script>
</head>
<body data-base={BASE}>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <div class="bar">
      <a class="brand" href={href('')}><img class="brand-mark" src={href('brand-64.png')} alt="" width="22" height="22" /> react-brain</a>
      <form class="search" action={href('search/')} method="get" role="search">
        <span aria-hidden="true" class="prompt">❯</span>
        <input id="nav-q" name="q" type="search" placeholder="ask — “should I use zustand?”" autocomplete="off" aria-label="Search the corpus" aria-keyshortcuts="Meta+K Control+K" />
        <kbd>⌘K</kbd>
      </form>
      <nav aria-label="Primary">
        {SECTIONS.map((s) => (
          <a class={`sec${activeSection === s.label ? ' active' : ''}`} href={href(s.to)} aria-current={activeSection === s.label ? (path === href(s.to) ? 'page' : 'true') : undefined}>{s.label}</a>
        ))}
        <a class="search-link" href={href('search/')}>search</a>
        <a class="gh" href={GITHUB} rel="noopener" aria-label="GitHub repository" title="GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </nav>
    </div>
  </header>

  <details class="mobile-nav" data-pagefind-ignore>
    <summary>Menu{activeSection && <span class="here"> · {activeSection}</span>}</summary>
    <nav class="mobile-nav-items" aria-label="Site menu">
      <div class="m-row m-primary">
        {SECTIONS.map((s) => <a class={activeSection === s.label ? 'active' : ''} href={href(s.to)}>{s.label}</a>)}
      </div>
      <p class="m-head">Decisions</p>
      <div class="m-row">
        {groups.map((g) => (
          <a class={activeGroup === g.id ? 'active' : ''} href={href(`entries/#${g.id}`)}>{groupLabel(g).toLowerCase()} <span class="count">{g.entries.length}</span></a>
        ))}
      </div>
      <p class="m-head">Tools · About</p>
      <div class="m-row m-quiet">
        {[...toolLinks, ...aboutLinks].map((l) => <a href={href(l.to)}>{l.label}</a>)}
      </div>
    </nav>
  </details>

  <div class="shell">
    <aside aria-label="Explore">
      <nav class="side-nav" aria-label="Explore decisions">
      <p class="label-caps side-head">Explore decisions</p>
      {groups.map((g) => (
        <a class={`side-item${activeGroup === g.id ? ' active' : ''}`} aria-current={activeGroup === g.id ? 'location' : undefined} href={href(`entries/#${g.id}`)}>
          <span aria-hidden="true" class="tree">▸</span>
          <span>{groupLabel(g).toLowerCase()}/</span>
          <span class="count">{g.entries.length}</span>
        </a>
      ))}
      <div class="side-bottom">
        <p class="label-caps side-sub">Tools</p>
        {toolLinks.map((l) => (
          <a class={`side-item quiet${under(l.to) ? ' active' : ''}`} aria-current={under(l.to) ? 'page' : undefined} href={href(l.to)}>{l.label}</a>
        ))}
        <p class="label-caps side-sub">About</p>
        {aboutLinks.map((l) => (
          <a class={`side-item quiet${under(l.to) ? ' active' : ''}`} aria-current={under(l.to) ? 'page' : undefined} href={href(l.to)}>{l.label}</a>
        ))}
      </div>
      </nav>
    </aside>

    <div class="content">
      <main id="main" data-pagefind-body={is404 ? undefined : ''}><slot /></main>
      <footer data-pagefind-ignore>
        <p class="statusline" aria-label="Corpus status">
          <span class="mode">v{meta.version}</span>
          <a href={href('entries/')}>{meta.decisions} decisions</a>
          <span class="dates">
            <a href={href('changelog/')} title="date this site was generated">built <time datetime={meta.built}>{meta.built}</time></a>
            <span aria-hidden="true">·</span>
            <a href={href('changelog/')} title="last commit that changed the corpus (entries or explanations)">corpus changed <time datetime={meta.contentLatest}>{meta.contentLatest}</time></a>
            <span aria-hidden="true">·</span>
            <a href={href('methodology/#metrics')} title="most recent date an entry was fetch-verified against primary sources">last verified <time datetime={meta.verifiedLatest}>{meta.verifiedLatest}</time></a>
          </span>
          <span class="end">
            <button type="button" class="console-link" data-open-console aria-keyshortcuts="Meta+J Control+J">console <kbd>⌘J</kbd></button>
            <span aria-hidden="true">·</span>
            <a href={href('methodology/#sources')}>sources</a>
          </span>
        </p>
        <p>Generated from the <a href={GITHUB}>react-brain corpus</a> — every fact carries a
        verified-on date; every recommendation is context-keyed and adversarially challenged
        (<a href={href('methodology/')}>methodology</a>). Articles are cited and linked, never
        republished: read the originals. Created by <a href="https://heartit.tech/" rel="noopener">heartit</a>.</p>
      </footer>
    </div>
  </div>

  <div id="console" hidden>
    <div class="console-scrim"></div>
    <div class="console-box" role="dialog" aria-modal="true" aria-label="react-brain console">
      <div class="console-out" id="c-out" aria-live="polite"></div>
      <form id="c-form" autocomplete="off">
        <span class="prompt" id="c-prompt">❯</span>
        <input id="c-in" type="text" spellcheck="false" autocomplete="off"
          placeholder="try: help · query maps · stack --rn --expo · load" aria-label="Console command" />
        <kbd>esc</kbd>
      </form>
    </div>
  </div>

  <script is:inline>
    // DESIGN.md: "Code Blocks: … with a Copy action in the top right"
    for (const pre of document.querySelectorAll('pre:not(.no-copy)')) {
      const text = pre.innerText;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'copy-btn'; b.textContent = 'copy';
      b.setAttribute('aria-label', 'Copy code to clipboard');
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); b.textContent = '✓'; }
        catch { b.textContent = '✗'; }
        setTimeout(() => (b.textContent = 'copy'), 1400);
      });
      pre.appendChild(b);
    }
    // honest shortcut hints per platform (the ⌘ glyph is Mac-only)
    if (!/Mac|iPhone|iPad/.test(navigator.platform))
      for (const k of document.querySelectorAll('.search kbd, .console-link kbd')) k.textContent = k.textContent.replace('⌘', 'Ctrl ');
    // ⌘K / Ctrl-K focuses the header search (Enter submits to search/); where the
    // field is hidden (narrow screens) it opens the search page instead. Escape in
    // the field blurs it and returns focus where it was. ⌘J (console) is console.js.
    (() => {
      // on the search page the page's own field (#q) is the better target
      const q = document.getElementById('q') || document.getElementById('nav-q');
      let back = null;
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (q && q.offsetParent !== null) { if (document.activeElement !== q) back = document.activeElement; q.focus(); q.select(); }
          else location.href = document.body.dataset.base + 'search/';
        }
      });
      q?.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        q.blur();
        if (back && back !== document.body && document.contains(back)) back.focus?.();
        back = null;
      });
    })();
  </script>

</body>
</html>

<style is:global>
  :root {
    /* "phosphor" — terminal-native palette (ANSI-derived, true black). The
       product is a CLI; the site dresses like its habitat. Mono is the UI voice;
       Inter stays for long-form prose only. */
    --bg: #0A0A0A;            /* terminal black */
    --card: #121312;          /* panel */
    --code-bg: #0E0F0E;       /* code panel */
    --line: #1F221F;          /* decorative hairlines (rows, dividers) — not for controls */
    --line-strong: #313530;
    --border-control: #5F665F; /* control borders: 3.35:1 on bg, 3.25:1 on code-bg, 3.15:1 on card (WCAG 1.4.11) */
    --fg: #D4D8D4;            /* body */
    --bright: #F2F5F2;        /* headings / emphasis */
    --muted: #8B948C;
    --accent: #50FA7B;        /* phosphor green: prompts, links, active, ✓ */
    --primary: #50FA7B;       /* primary action = green key */
    --on-primary: #0A0A0A;
    --ok: #50FA7B;            /* ANSI green */
    --warn: #E7C664;          /* ANSI yellow */
    --bad: #FF7B72;           /* ANSI red */
    --exp: #BD93F9;           /* ANSI magenta */
    --font-head: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --header-h: 56px;

    /* type scale — nothing renders below --fs-xs */
    --fs-xs: .75rem;          /* 12px — meta, badges, kbd, labels */
    --fs-sm: .875rem;         /* 14px — secondary copy, tables, nav */
    --fs-md: 1rem;            /* 16px — body */
    --fs-lg: 1.125rem;        /* 18px — ledes, h3 */
    --fs-xl: 1.25rem;         /* 20px — h2 */
    --fs-2xl: 1.5rem;         /* 24px — stat numbers, prose h1 */
    --fs-code: 13px;          /* pre / terminal blocks */
    /* spacing */
    --sp-1: .25rem; --sp-2: .5rem; --sp-3: .75rem; --sp-4: 1rem; --sp-6: 1.5rem; --sp-8: 2rem; --sp-12: 3rem;
    --measure: 60ch;          /* max line length for running text (≈ 72–76 chars in Inter) */
    --radius-sm: 4px; --radius-md: 8px; --radius-lg: 10px;
    /* the only two elevation levels */
    --shadow-raised: inset 0 1px 0 color-mix(in srgb, var(--bright) 6%, transparent), 0 16px 40px -20px color-mix(in srgb, var(--bg) 95%, transparent);
    --shadow-overlay: inset 0 1px 0 color-mix(in srgb, var(--bright) 7%, transparent), 0 40px 90px -30px var(--bg);
    /* reserved: the hero terminal and focus states (hover on primary buttons) */
    --glow: color-mix(in srgb, var(--accent) 35%, transparent);
    color-scheme: dark;       /* dark-first by design */
  }
  * { box-sizing: border-box; }
  /* author display rules (e.g. button { display: inline-block }) must never beat the hidden attribute */
  [hidden] { display: none !important; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 400 var(--fs-md)/1.65 var(--font-body); }
  body::before { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 42% at 62% -8%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 68%),
      radial-gradient(42% 32% at 6% 14%, color-mix(in srgb, var(--accent) 6%, transparent), transparent 62%); }

  /* ── top bar ─────────────────────────────────────────────────────────────── */
  header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 5; }
  .bar { max-width: 1500px; margin: 0 auto; padding: 0 20px; height: var(--header-h); display: flex; gap: 1.1rem; align-items: center; min-width: 0; }
  .brand { color: var(--bright); font: 700 var(--fs-md) var(--font-mono); padding-block: var(--sp-2); display: inline-flex; align-items: center; gap: var(--sp-2); text-decoration: none; white-space: nowrap; }
  /* the mark ships with its navy background baked in — rendered as a rounded chip
     with a hairline border it reads as an app icon, not a mismatched patch */
  .brand-mark { width: 22px; height: 22px; border-radius: var(--radius-sm); border: 1px solid var(--line); display: block; }
  .prompt { color: var(--accent); font-family: var(--font-mono); font-weight: 700; }
  .search { flex: 1 1 160px; min-width: 0; max-width: 430px; display: flex; align-items: center; gap: var(--sp-2); background: var(--code-bg); border: 1px solid var(--border-control); border-radius: var(--radius-sm); padding: 0 .7rem; color: var(--muted); }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 2px var(--glow); }
  .search input { flex: 1; min-width: 0; padding-block: var(--sp-2); background: none; border: 0; color: var(--fg); font: 400 var(--fs-sm) var(--font-mono); }
  .search input:focus { outline: none; box-shadow: none; border: 0; }
  .search kbd { background: var(--bg); }
  header nav { margin-left: auto; display: flex; gap: 1.05rem; align-items: center; flex-shrink: 0; }
  header nav a { color: var(--muted); text-decoration: none; font: 500 var(--fs-sm) var(--font-mono); white-space: nowrap; padding: .95rem .15rem; }
  header nav a:hover { color: var(--fg); }
  /* active section: green text + a 2px underline — unmistakable without relying on color alone
     (an inset "border", not elevation — the only box-shadow outside the two shadow tokens) */
  header nav a.active { color: var(--accent); box-shadow: inset 0 -2px 0 var(--accent); }
  header nav .gh { display: inline-flex; padding: .95rem var(--sp-1); }
  /* narrow screens swap the search field for a plain link (see ≤640px below) */
  .search-link { display: none; }

  /* ── shell: sidebar + content ────────────────────────────────────────────── */
  .shell { max-width: 1500px; margin: 0 auto; display: grid; grid-template-columns: 250px minmax(0, 1fr); }
  aside { border-right: 1px solid var(--line); padding: 1.1rem .9rem 1.1rem 20px; position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h)); overflow-y: auto; display: flex; flex-direction: column; }
  .side-nav { display: flex; flex-direction: column; flex: 1 0 auto; }
  .side-head { color: var(--muted); margin: 0; }
  .side-item { display: flex; align-items: center; gap: var(--sp-2); color: var(--muted); text-decoration: none; font: 400 var(--fs-sm) var(--font-mono); padding: .6rem .55rem; border-radius: var(--radius-sm); border-left: 2px solid transparent; }
  .side-item:hover { color: var(--fg); background: var(--card); }
  .side-item.active { color: var(--accent); background: var(--card); border-left-color: var(--accent); }
  .side-item .tree { color: var(--line-strong); }
  .side-item.active .tree { color: var(--accent); }
  .side-item .count { margin-left: auto; font: 400 var(--fs-xs) var(--font-mono); color: var(--muted); }
  /* tools/about are secondary: smaller and tighter than the decision groups (still ≥ 24px tall) */
  .side-item.quiet { font-size: var(--fs-xs); padding: .32rem .55rem; min-height: 24px; }
  .side-bottom { margin-top: auto; padding-top: .4rem; border-top: 1px solid var(--line); }
  .side-sub { margin: .85rem 0 .15rem; padding-left: .55rem; font-size: var(--fs-xs); color: var(--muted); }
  .content main { max-width: 1140px; margin: 0 auto; padding: 2.4rem 28px 5rem; }
  footer { border-top: 1px solid var(--line); color: var(--muted); font-size: var(--fs-sm); }
  footer p { max-width: 1200px; margin: 0 auto; padding: 1rem 24px 2rem; }
  .mobile-nav { display: none; border-bottom: 1px solid var(--line); }
  .mobile-nav summary { cursor: pointer; padding: .7rem 20px; font: 600 var(--fs-xs)/1.4 var(--font-body); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); list-style: none; }
  .mobile-nav summary::before { content: '☰  '; }
  .mobile-nav[open] summary { color: var(--fg); }
  .mobile-nav summary .here { color: var(--accent); text-transform: none; letter-spacing: 0; font-family: var(--font-mono); }
  .mobile-nav-items { padding: 0 20px .9rem; }
  .m-row { display: flex; flex-wrap: wrap; gap: .4rem .5rem; }
  .m-head { margin: .8rem 0 .35rem; font: 500 var(--fs-xs) var(--font-mono); color: var(--muted); }
  .m-row a { color: var(--muted); text-decoration: none; font: 400 var(--fs-sm) var(--font-mono); padding: .4rem .55rem; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .m-row a.active { color: var(--accent); border-color: var(--accent); }
  .m-primary a { color: var(--fg); font-weight: 600; padding: var(--sp-2) var(--sp-3); }
  .m-quiet a { border-color: transparent; padding-inline: .3rem; font-size: var(--fs-sm); }
  .m-row a .count { color: var(--muted); font: 500 var(--fs-xs) var(--font-mono); }
  @media (max-width: 1023px) {
    aside { display: none; }
    .mobile-nav { display: block; }
    .shell { grid-template-columns: minmax(0, 1fr); }
    .search kbd { display: none; }
    header nav { gap: .8rem; }
  }
  @media (max-width: 640px) {
    /* the four sections live in the Menu below the bar; the bar keeps brand · search link · GitHub */
    .search, header nav a.sec { display: none; }
    .search-link { display: inline; }
    .bar { gap: .8rem; padding: 0 16px; }
    .mobile-nav summary, .mobile-nav-items { padding-inline: 16px; }
  }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--radius-sm); }
  .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--on-primary); padding: var(--sp-2) var(--sp-4); z-index: 10; }
  .skip:focus { left: var(--sp-2); top: var(--sp-2); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* typography — hierarchy comes from the scale, not only weight/color.
     h1 stays fluid (27px phone → 50px desktop): the one size outside the --fs-* steps. */
  h1, h2, h3 { font-family: var(--font-head); color: var(--bright); text-wrap: balance; }
  p { text-wrap: pretty; }
