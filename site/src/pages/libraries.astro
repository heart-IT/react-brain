---
import Base from '../layouts/Base.astro';
import { corpus, downloads, fmtDownloads, href } from '../lib/corpus.js';
const { entries } = corpus();
const dl = downloads();
// one row per concrete npm package the corpus tracks, joined to its owning entry
const rows = entries.flatMap((e) => (e.detect || [])
  .filter((d) => !d.pkg.includes('*'))
  .map((d) => ({ pkg: d.pkg, label: d.label, entry: e, weekly: dl[d.pkg] ?? null })));
rows.sort((a, b) => (b.weekly || 0) - (a.weekly || 0));
---
<Base title="react-brain — library browser">
  <h1>Library browser</h1>
  <p class="muted lede">Every concrete package the corpus tracks, joined to the decision it belongs to.
  Downloads are npm weekly figures from the corpus's last <code>signals</code> run — the same live
  check that keeps recommendations honest. A big number is popularity, <em>not</em> a verdict:
  click through to the entry for the context-keyed recommendation.</p>
  <p>
    <label for="lib-filter" class="label-caps filter-label">Filter</label>
    <input id="lib-filter" class="filter" type="search" placeholder="package, label, or decision…" autocomplete="off" />
    <span id="lib-count" class="meta count" aria-live="polite"></span>
  </p>
  <div class="tbl wide"><table>
    <thead><tr><th scope="col">package</th><th scope="col">what the corpus calls it</th><th scope="col">decision</th><th scope="col" class="num">npm / week</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><code>{r.pkg}</code></td>
          <td>{r.label}</td>
          <td><a href={href(`entries/${r.entry.slug}/`)}>{r.entry.slug}</a> <span class={`badge ${r.entry.confidence}`}>{r.entry.confidence}</span></td>
          <td class="num">{r.weekly != null ? fmtDownloads(r.weekly) : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table></div>

  <script is:inline>
    const rows = [...document.querySelectorAll('tbody tr')].map((tr) => [tr, tr.textContent.toLowerCase()]);
    const count = document.getElementById('lib-count');
    const total = rows.length;
    count.textContent = `${total} packages`;
    document.getElementById('lib-filter').addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      let shown = 0;
      for (const [tr, text] of rows) { const hit = !q || text.includes(q); tr.hidden = !hit; if (hit) shown++; }
      count.textContent = q ? `${shown} of ${total} packages` : `${total} packages`;
    });
  </script>
</Base>

<style>
  .lede { max-width: var(--measure); }
  .filter-label { display: block; color: var(--muted); margin: 0 0 var(--sp-2); }
  .filter { width: 100%; max-width: 26rem; background: var(--card); border: 1px solid var(--border-control); border-radius: var(--radius-sm); padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm); }
  .count { margin-inline-start: var(--sp-3); }
</style>
