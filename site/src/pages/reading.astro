---
import Base from '../layouts/Base.astro';
import { corpus, href } from '../lib/corpus.js';
const { groups, entries } = corpus();
const count = entries.reduce((n, e) => n + (e.reading?.length || 0), 0);
const host = (u) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; } };
// Skim structure without hiding evidence: the LEAD line is the tagged claim when the
// corpus has distilled one, else the annotation's first sentence; the rest stays
// visible below it in muted text. Nothing is clamped away.
const split = (r) => {
  if (r.claim) return { lead: r.claim, rest: r.what };
  const first = String(r.what || '').split(/(?<=\.)\s+/)[0] || '';
  return { lead: first, rest: String(r.what || '').slice(first.length).trim() };
};
---
<Base title="react-brain — curated reading">
  <h1>Curated reading</h1>
  <p class="muted intro">{count} deep-dives, every one fetch-verified and annotated with <em>why it matters</em> —
  organized by the decision it informs, not by publish date. The annotations are our editorial take; <strong>the articles are the originals — read them there.</strong> A piece lands here only if it's the
  canonical explanation for its topic; how-to content routes to depth skills instead.</p>
  <nav class="jump" aria-label="Jump to group">
    {groups.map((g) => (
      <a href={`#${g.id}`}>{g.label.split(' — ')[0].split(' (')[0]} <span class="n">{g.entries.reduce((n, id) => n + (entries.find((x) => x.id === id)?.reading?.length || 0), 0)}</span></a>
    ))}
  </nav>
  {groups.map((g) => (
    <section id={g.id}>
      <h2>{g.label}</h2>
      {g.entries.map((id) => {
        const e = entries.find((x) => x.id === id);
        return e?.reading?.length > 0 && (
          <div>
            <h3><a href={href(`entries/${e.slug}/`)}>{e.slug}</a> <span class="muted topic">— {e.topic}</span></h3>
            <div class="rows">
              {e.reading.map((r) => {
                const { lead, rest } = split(r);
                return (
                  <div class="read-item">
                    <p class="read-head">
                      <a href={r.url} rel="noopener" class="read-title">{r.title}</a>
                      <span class="meta">{[r.by, host(r.url)].filter(Boolean).join(' · ')}</span>
                    </p>
                    <p class="read-lead">{lead}</p>
                    {rest && <p class="read-rest muted">{rest}</p>}
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </section>
  ))}
</Base>

<style>
  h3 .topic { font-size: var(--fs-sm); font-weight: 400; }
  .intro { max-width: var(--measure); }
  .jump { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: var(--sp-4) 0 0; }
  .jump a { display: inline-flex; align-items: center; gap: var(--sp-1); min-height: 24px; padding: var(--sp-1) var(--sp-2);
    border: 1px solid var(--border-control); border-radius: var(--radius-sm); text-decoration: none;
    font: 400 var(--fs-xs)/1.4 var(--font-mono); color: var(--fg); }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }
  .jump .n { color: var(--muted); }
  /* annotations quote long config keys (experimental.turbopackChunking…) — let them break */
  .read-item, section h3 { overflow-wrap: anywhere; }
  .read-head { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-1) var(--sp-2); }
  .read-title { font: 600 var(--fs-md)/1.4 var(--font-head); color: var(--bright); text-decoration: none; }
  .read-title:hover { color: var(--accent); }
  .read-lead { margin: .3rem 0 0; font-size: var(--fs-sm); line-height: 1.55; color: var(--fg); max-width: var(--measure); }
  .read-rest { margin: .25rem 0 0; font-size: var(--fs-sm); line-height: 1.55; max-width: var(--measure); }
</style>
