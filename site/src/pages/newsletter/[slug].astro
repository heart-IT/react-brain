---
import Base from '../../layouts/Base.astro';
import { newsletterIssues, issueHtml, href } from '../../lib/corpus.js';

export function getStaticPaths() {
  const issues = newsletterIssues();
  return issues.map((it, i) => ({
    params: { slug: it.slug },
    // newest-first order, so "newer" is the previous index
    props: { issue: it, newer: issues[i - 1] || null, older: issues[i + 1] || null },
  }));
}
const { issue, newer, older } = Astro.props;
const html = issueHtml(issue);
---
<Base title={`react-brain weekly #${issue.number} — ${issue.title}`} description={issue.dek}>
  <p class="meta"><a href={href('newsletter/')}>react-brain weekly</a> · #{issue.number} · {issue.slug}</p>
  <h1 class="title">{issue.title}</h1>
  <p class="muted dek">{issue.dek}</p>
  <article class="prose" set:html={html} />
  {(older || newer) && <nav class="pager" aria-label="Older and newer issues">
    {older ? <a class="prev" href={href(`newsletter/${older.slug}/`)} rel="prev"><span class="meta">← older · #{older.number}</span><span class="pg-title">{older.title}</span></a> : <span />}
    {newer ? <a class="next" href={href(`newsletter/${newer.slug}/`)} rel="next"><span class="meta">newer · #{newer.number} →</span><span class="pg-title">{newer.title}</span></a> : <span />}
  </nav>}
</Base>

<style>
  .title { max-width: 24ch; }
  .dek { max-width: var(--measure); font-size: var(--fs-lg); }
  .prose { max-width: var(--measure); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); margin: var(--sp-12) 0 0; padding-top: var(--sp-4); border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: .15rem; text-decoration: none; min-width: 0; }
  .pager .next { text-align: end; }
  .pg-title { color: var(--fg); font-size: var(--fs-sm); }
  .pager a:hover .pg-title { color: var(--accent); }
</style>
