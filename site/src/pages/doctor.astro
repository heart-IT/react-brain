---
// In-browser doctor. The page ships no corpus data: the analysis logic is
// lib/doctor-core.js (the same module the homepage demo runs at build time,
// bundled here by Vite), and the corpus tables come from doctor-data.json,
// fetched once on the first Analyze.
import Base from '../layouts/Base.astro';
import { BASE, href } from '../lib/corpus.js';
---
<Base title="Doctor" description="Paste a package.json and get an ecosystem-fit report and migration findings against the verified corpus — runs entirely in your browser.">
  <h1>Doctor</h1>
  <p class="kicker"><span class="badge beta">beta</span> · runs in your browser</p>
  <p class="muted prose">Paste a <code>package.json</code>. Each dependency is matched against the corpus's
  detection table, every detected choice is compared to the context-keyed recommendation, installed
  versions are crossed with the verified migration rules, and expected-but-missing domains are flagged.
  The full CLI (<code>npx -y @heart-it/react-brain doctor .</code>) adds what a browser can't see: the
  legacy-API source scan and source-level signals. Ready to commit a choice?
  <a href={href('decide/')}>Generate a decision record</a>.</p>

  <section class="dr-legend" aria-labelledby="legend-h">
    <h2 id="legend-h" class="label-caps">How to read the report</h2>
    <dl>
      <dt>fit</dt>
      <dd><span class="mark-ok">✓ aligned</span> matches the default for some context ·
        <span class="mark-warn">~ contextual</span> matches a when-clause ·
        <span class="mark-dim">↗ review</span> differs from the default (not necessarily wrong — check the entry's context keys)</dd>
      <dt>urgency</dt>
      <dd><span class="mark-warn">✗ dead</span> / <span class="mark-warn">✗ deprecated</span> act now ·
        <span class="mark-dim">→ superseded</span> / <span class="mark-dim">→ upgrade</span> / <span class="mark-dim">→ conditional</span> plan it ·
        <span class="mark-dim">⛔ blocked</span> another step must land first</dd>
      <dt>gap</dt>
      <dd>an expected domain with nothing detected — may be built in, or genuinely N/A for your architecture</dd>
    </dl>
  </section>

  <div id="doctor" data-base={BASE}>
    <label for="pkg" class="label-caps pkg-label">Your package.json</label>
    <p class="meta" id="privacy">Runs entirely in your browser — nothing is uploaded; only dependency names and versions are read.</p>
    <textarea id="pkg" aria-describedby="privacy" spellcheck="false" placeholder='{"dependencies": {"react": "19.2.0", "zustand": "5.0.0", ...}}'></textarea>
    <p class="dr-actions">
      <button id="run" type="button">Analyze</button>
      <label class="btn ghost file-btn">Load a file<input id="file" class="sr-only" type="file" accept=".json,application/json" /></label>
      <button id="sample" type="button" class="btn ghost">Try the sample</button>
      <span class="meta">sample: legacy-rn-demo (fictional manifest)</span>
    </p>
    <p class="dr-actions" id="exports" hidden>
      <button id="copy" type="button" class="btn ghost">Copy report</button>
      <button id="download" type="button" class="btn ghost">Download .md</button>
      <span id="export-status" class="meta" role="status"></span>
    </p>
    <div id="out" aria-live="polite"></div>
  </div>

  <script>
    import { analyze, stageOf, depsOf, hostOf, matchDetector, SAMPLE } from '../lib/doctor-core.js';

    const root = document.getElementById('doctor');
    const BASE = root.dataset.base || '/';
    const $ = (id) => document.getElementById(id);
    const out = $('out');
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const clip = (s, n) => (s.length > n ? s.slice(0, n) + '…' : s);
    const entryUrl = (slug) => `${BASE}entries/${slug}/`;
    const safeUrl = (u) => (/^https?:\/\//i.test(u) ? u : null);
    const SEVERE = new Set(['dead', 'deprecated']);
    const migrateUrl = (slug) => `${entryUrl(slug)}#migrate`;
    const actNow = (s) => !s.blocked && SEVERE.has(s.urgency);
    const CLI = ['npx -y @heart-it/react-brain doctor .', 'npx -y @heart-it/react-brain migrate .', 'npx -y @heart-it/react-brain review . --ci'];

    // corpus tables: fetched once, on demand
    let dataPromise = null;
    const loadData = () => (dataPromise ||= fetch(`${BASE}doctor-data.json`).then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    }).catch((err) => { dataPromise = null; throw err; }));

    let report = null;   // { md, name }

    const fitClass = (f) => (f.startsWith('✓') ? 'mark-ok' : f.startsWith('~') ? 'mark-warn' : 'mark-dim');

    function render(pkg, data) {
      const a = analyze(pkg, data);
      const stage = stageOf(pkg);
      const { caps } = data;
      const md = [`# react-brain doctor — ${a.name}`, '',
        `platform: ${a.platform} · stage (guess): ${stage} · ${a.depCount} deps · corpus v${data.v}, verified ${data.verified}`, ''];

      const tally = { '✓': 0, '~': 0, '↗': 0 };
      for (const f of a.fits) tally[f.fit[0]]++;

      // ── summary: fit (review) and urgency (act now / plan) are independent axes ──
      const nAct = a.steps.filter(actNow).length;
      const nPlan = a.steps.length - nAct;
      const nReview = tally['↗'];
      const deps = Object.keys(depsOf(pkg));
      const nMatched = deps.filter((n) => { const d = matchDetector(n, data.detectors); return d && caps[d[1]]; }).length;
      // already ordered unblocked-first then by urgency; stable re-sort makes the act-now steps lead
      const next = [...a.steps].sort((x, y) => (actNow(x) ? 0 : 1) - (actNow(y) ? 0 : 1)).slice(0, 3);
      const stepLine = (s) => `${s.name}@${s.installed} → ${s.to}`;

      let html = `<p class="dr-context"><strong>${esc(a.name)}</strong> · platform: ${esc(a.platform)} · stage (guess, manifest only): ${esc(stage)} · ${a.depCount} deps · ${a.fits.length} decisions detected</p>`;

      html += '<section class="dr-summary" aria-labelledby="summary-h"><h2 id="summary-h">Summary</h2><dl class="dr-counts">' +
        `<div><dt>Act now</dt><dd class="dr-n">${nAct}</dd><dd class="meta">unblocked steps that are dead or deprecated</dd></div>` +
        `<div><dt>Plan</dt><dd class="dr-n">${nPlan}</dd><dd class="meta">superseded, upgrade, conditional or blocked steps</dd></div>` +
        `<div><dt>Review</dt><dd class="dr-n">${nReview}</dd><dd class="meta">choices that differ from the default — contextual, not necessarily wrong</dd></div>` +
        '</dl>' +
        `<p class="meta dr-note">${a.gaps.length} gap${a.gaps.length === 1 ? '' : 's'} (expected domains with nothing detected) · ` +
        `${nMatched} of ${deps.length} dependencies matched a decision — the rest are not judged.</p>`;
      md.push('## Summary', '',
        `- act now: ${nAct} (unblocked dead/deprecated steps)`,
        `- plan: ${nPlan} (superseded/upgrade/conditional/blocked steps)`,
        `- review: ${nReview} (choices that differ from the default — not necessarily wrong)`,
        `- gaps: ${a.gaps.length}`,
        `- ${nMatched} of ${deps.length} dependencies matched a decision — the rest are not judged`, '');

      html += '<h3 id="next-h">Recommended next actions</h3>';
      md.push('### Recommended next actions', '');
      if (next.length) {
        html += '<ol class="rows dr-next">' + next.map((s) =>
          `<li><p class="f-what"><strong>${esc(stepLine(s))}</strong> <span class="meta">${actNow(s) ? 'act now' : s.blocked ? 'plan · blocked' : 'plan'} · ${esc(s.urgency)}</span></p>` +
          `<p class="f-why">${esc(clip(s.why, 200))}</p>` +
          `<p class="meta f-facts"><a href="${entryUrl(s.slug)}">open decision</a> · <a href="${migrateUrl(s.slug)}">migration rule</a></p></li>`).join('') +
          '</ol>';
        next.forEach((s, i) => md.push(`${i + 1}. **${stepLine(s)}** (${actNow(s) ? 'act now' : 'plan'}, ${s.urgency}) — ${s.why}`,
          `   - decision: ${location.origin}${entryUrl(s.slug)} · migration rule: ${location.origin}${migrateUrl(s.slug)}`));
      } else {
        html += '<p class="muted">No migration steps — nothing to act on from installed versions.</p>';
        md.push('No migration steps — nothing to act on from installed versions.');
      }
      html += '</section>';
      md.push('');

      // ── fit ──
      html += '<h2 id="fit">Fit</h2>';
      if (a.fits.length) {
        html += `<p class="meta">fit: <span class="mark-ok">✓ ${tally['✓']} aligned</span> · <span class="mark-warn">~ ${tally['~']} contextual</span> · <span class="mark-dim">↗ ${tally['↗']} to review</span></p>`;
        html += '<div class="tbl wide"><table><thead><tr><th scope="col">decision</th><th scope="col">your choice</th><th scope="col">fit</th><th scope="col">the corpus says</th></tr></thead><tbody>';
        md.push('## Fit', '', '| decision | your choice | fit |', '|---|---|---|');
        for (const f of a.fits) {
          const def = caps[f.id]?.def || '';
          html += `<tr><td><a href="${entryUrl(f.slug)}">${esc(f.slug)}</a> <span class="badge ${esc(f.confidence)}">${esc(f.confidence)}</span></td>` +
            `<td>${esc(f.choice)}</td><td><span class="${fitClass(f.fit)}">${esc(f.fit)}</span></td>` +
            `<td class="muted">${esc(clip(def, 160))}</td></tr>`;
          md.push(`| ${f.slug} | ${f.choice} | ${f.fit} |`);
        }
        html += '</tbody></table></div>';
        md.push('');
      } else {
        html += '<p class="muted">No dependency matched the detection table.</p>';
      }

      // ── findings: migration steps ──
      html += '<h2 id="findings">Findings</h2>';
      md.push('## Findings', '');
      if (a.steps.length) {
        html += '<p class="muted dr-note">Installed versions crossed with the corpus\'s verified migration rules — unblocked first, then by urgency.</p><div class="rows dr-findings">';
        for (const s of a.steps) {
          const severe = SEVERE.has(s.urgency);
          const glyph = s.blocked ? '⛔' : severe ? '✗' : '→';
          const applies = s.below ? `${s.pkg} < ${s.below}` : `all versions of ${s.pkg}`;
          const receipts = (s.receipts || []).map(safeUrl).filter(Boolean);
          html += '<div>' +
            `<p class="f-what"><span class="${severe && !s.blocked ? 'mark-warn' : 'mark-dim'}" aria-hidden="true">${glyph}</span> ` +
              `<strong>${esc(s.name)}</strong><span class="meta">@${esc(s.installed)}</span> → ${esc(s.to)}</p>` +
            `<p class="meta f-facts">urgency <strong class="${severe ? 'mark-warn' : 'mark-dim'}">${esc(s.urgency)}</strong> · effort ${esc(s.effort)} · applies to: ${esc(applies)}</p>` +
            `<p class="f-why">${esc(s.why)}</p>` +
            (s.blocked ? `<p class="f-why"><strong>⛔ blocked by</strong> ${esc(s.blocked)} — do that step first</p>` : '') +
            `<p class="meta f-facts">receipts: ${receipts.length
              ? receipts.map((u) => `<a href="${esc(u)}" rel="noopener">${esc(hostOf(u))}</a>`).join(' · ')
              : 'none recorded'} · next: <a href="${entryUrl(s.slug)}">entries/${esc(s.slug)}</a> · <a href="${migrateUrl(s.slug)}">migration rule</a></p>` +
            '</div>';
          md.push(`- ${glyph} **${s.name}@${s.installed} → ${s.to}** — urgency ${s.urgency}, effort ${s.effort}, applies to: ${applies}`,
            `  - why: ${s.why}`,
            ...(s.blocked ? [`  - blocked by: ${s.blocked}`] : []),
            ...(receipts.length ? [`  - receipts: ${receipts.join(' · ')}`] : []),
            `  - next: ${location.origin}${entryUrl(s.slug)} · migration rule: ${location.origin}${migrateUrl(s.slug)}`);
        }
        html += '</div>';
      } else {
        html += '<p class="muted">No migration rule matches your installed versions.</p>';
        md.push('No migration rule matches the installed versions.');
      }
      md.push('');

      // ── gaps ──
      html += '<h2 id="gaps">Gaps</h2>';
      md.push('## Gaps', '');
      if (a.gaps.length) {
        html += '<p class="muted dr-note">Nothing detected for these expected domains — may be built in, or genuinely N/A for your architecture; verify.</p><div class="rows">';
        for (const id of a.gaps) {
          const cap = caps[id];
          html += `<div><p class="gap-what"><a href="${entryUrl(cap.slug)}"><strong>${esc(cap.slug)}</strong></a> <span class="meta">nothing detected — may be N/A</span></p>` +
            `<p class="muted gap-def">${esc(clip(cap.def, 180))}</p></div>`;
          md.push(`- ${cap.slug}: nothing detected — may be N/A`);
        }
        html += '</div>';
      } else {
        html += '<p class="muted">Every expected domain has something detected.</p>';
        md.push('Every expected domain has something detected.');
      }
      // ── continue locally ──
      const cliWhy = 'The CLI reads your source too: it adds the legacy-API scan, source-level signals and a sequenced migration plan. ' +
        'Run migrate when you are ready to do the work; run review --ci in CI to fail a build on new drift.';
      html += '<section class="dr-local" aria-labelledby="local-h"><h2 id="local-h">Continue locally</h2>' +
        `<pre class="no-copy"><code>${CLI.map(esc).join('\n')}</code></pre><p class="muted dr-note">${esc(cliWhy)}</p></section>`;
      md.push('## Continue locally', '', '```sh', ...CLI, '```', '', cliWhy, '',
        `Generated in the browser by ${location.origin}${BASE}doctor/`);

      out.innerHTML = html;
      addCopy(out.querySelector('.dr-local pre'));
      report = { md: md.join('\n'), name: a.name };
      $('exports').hidden = false;
      $('export-status').textContent = '';
      out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Base.astro adds copy buttons only to <pre> present at load; this one is rendered later
    function addCopy(pre) {
      const text = CLI.join('\n');
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'copy-btn'; b.textContent = 'copy';
      b.setAttribute('aria-label', 'Copy commands to clipboard');
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); b.textContent = '✓'; }
        catch { b.textContent = '✗'; }
        setTimeout(() => (b.textContent = 'copy'), 1400);
      });
      pre.appendChild(b);
    }

    async function run() {
      let pkg;
      try { pkg = JSON.parse($('pkg').value); }
      catch { out.innerHTML = '<p class="err">That is not valid JSON.</p>'; return; }
      if (!pkg || typeof pkg !== 'object' || !Object.keys(depsOf(pkg)).length) {
        out.innerHTML = '<p class="err">No dependencies found — paste a package.json with <code>dependencies</code> or <code>devDependencies</code>.</p>';
        return;
      }
      const btn = $('run');
      btn.disabled = true;
      out.setAttribute('aria-busy', 'true');
      out.innerHTML = '<p class="meta">loading the corpus tables…</p>';
      try {
        render(pkg, await loadData());
      } catch (err) {
        out.innerHTML = `<p class="err">Could not load the corpus data (${esc(err.message)}). Check your connection and try again.</p>`;
      } finally {
        btn.disabled = false;
        out.removeAttribute('aria-busy');
      }
    }

    $('run').addEventListener('click', run);
    $('sample').addEventListener('click', () => {
      $('pkg').value = JSON.stringify(SAMPLE, null, 2);
      run();
    });
    $('file').addEventListener('change', async (ev) => {
      const file = ev.target.files[0];
      if (!file) return;
      $('pkg').value = await file.text();
      run();
    });

    const status = (msg) => {
      $('export-status').textContent = msg;
      setTimeout(() => { if ($('export-status').textContent === msg) $('export-status').textContent = ''; }, 2000);
    };
    $('copy').addEventListener('click', async () => {
      if (!report) return;
      try { await navigator.clipboard.writeText(report.md); status('copied ✓'); }
      catch { status('copy failed — use Download .md'); }
    });
    $('download').addEventListener('click', () => {
      if (!report) return;
      const url = URL.createObjectURL(new Blob([report.md], { type: 'text/markdown' }));
      const a = Object.assign(document.createElement('a'), {
        href: url, download: `react-brain-doctor-${report.name.replace(/[^\w.-]+/g, '-')}.md`,
      });
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  </script>
</Base>

<style>
  .dr-legend { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: .6rem 0; margin: 1rem 0 1.4rem; }
  .dr-legend h2 { margin: 0 0 .4rem; font-size: var(--fs-xs); }
  .dr-legend dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1rem; margin: 0; font-size: var(--fs-sm); }
  .pkg-label { display: block; margin-block-end: var(--sp-2); }
  #privacy { margin: 0 0 var(--sp-2); }
  .file-btn { position: relative; cursor: pointer; margin: 0; }
  .file-btn:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dr-legend dt { font-family: var(--font-mono); color: var(--muted); }
  .dr-legend dd { margin: 0; max-width: var(--measure); }
  @media (max-width: 600px) {
    .dr-legend dl { grid-template-columns: 1fr; }
    .dr-legend dd { margin-bottom: .4rem; }
  }
  .dr-actions { display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; }
  #out :global(.dr-context) { font-family: var(--font-mono); font-size: var(--fs-sm); overflow-wrap: anywhere; }
  #out :global(.dr-note) { font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.gap-what) { margin: 0; }
  #out :global(.gap-def) { margin: var(--sp-1) 0 0; font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.dr-findings p) { margin: 0; }
  #out :global(.dr-findings p + p) { margin-top: .3rem; }
  #out :global(.f-what) { overflow-wrap: anywhere; }
  #out :global(.f-why) { font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.f-facts) { overflow-wrap: anywhere; }
  #out :global(.dr-counts) { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border-block: 1px solid var(--line); }
  #out :global(.dr-counts > div) { padding: var(--sp-3) var(--sp-4); border-inline-start: 1px solid var(--line); }
  #out :global(.dr-counts > div:first-child) { border-inline-start: 0; padding-inline-start: 0; }
  #out :global(.dr-counts dt) { font: 600 var(--fs-xs) var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  #out :global(.dr-counts dd) { margin: 0; }
  #out :global(.dr-n) { font: 600 var(--fs-2xl)/1.2 var(--font-mono); color: var(--bright); font-variant-numeric: tabular-nums; }
  #out :global(.dr-next) { padding: 0; list-style: none; }
  #out :global(.dr-next p) { margin: 0; }
  #out :global(.dr-next p + p) { margin-top: var(--sp-1); }
  #out :global(.dr-summary h3) { font-size: var(--fs-md); margin-block: var(--sp-6) var(--sp-2); }
  @media (max-width: 600px) {
    #out :global(.dr-counts) { grid-template-columns: 1fr; }
    #out :global(.dr-counts > div) { border-inline-start: 0; padding-inline: 0; display: grid; grid-template-columns: 6rem auto 1fr; gap: var(--sp-3); align-items: baseline; }
    #out :global(.dr-counts > div + div) { border-block-start: 1px solid var(--line); }
  }
</style>
