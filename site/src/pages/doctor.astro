---
// In-browser doctor. The page ships no corpus data: the analysis logic is
// lib/doctor-core.js (the same module the homepage demo runs at build time,
// bundled here by Vite), and the corpus tables come from doctor-data.json,
// fetched once on the first Analyze. A saved project (lib/project.js) is re-opened
// and re-checked on load; "Save as my project" makes the report the home dashboard.
import Base from '../layouts/Base.astro';
import { BASE, href } from '../lib/corpus.js';
---
<Base title="Check my app" description="Paste a package.json: see what to fix, which choices match our pick and what is still undecided — runs entirely in your browser.">
  <h1>Check my app</h1>
  <p class="kicker"><span class="badge beta">beta</span> · runs in your browser · nothing is uploaded</p>
  <p class="muted prose">Paste your <code>package.json</code>. You get three things: what to fix (outdated or
  dead packages), how each library you chose compares to our pick, and the topics you haven't decided yet.
  Save it as your project and the home page becomes your dashboard.</p>

  <details class="dr-legend">
    <summary class="label-caps">How to read the report</summary>
    <dl>
      <dt>your choices</dt>
      <dd><span class="mark-ok">✓ matches our pick</span> ·
        <span class="mark-warn">~ fits some contexts</span> (our pick for a specific situation — check it is yours) ·
        <span class="mark-dim">↗ differs — worth a look</span> (not necessarily wrong)</dd>
      <dt>to fix</dt>
      <dd><span class="mark-warn">✗ replace now</span> / <span class="mark-warn">✗ replace soon</span> dead or deprecated ·
        <span class="mark-dim">→ better option exists</span> / <span class="mark-dim">→ upgrade available</span> / <span class="mark-dim">→ upgrade if it applies</span> plan it ·
        <span class="mark-dim">⛔ blocked</span> another step must land first</dd>
      <dt>not decided yet</dt>
      <dd>a topic most apps need, with nothing detected — may be built in, or not apply to you</dd>
    </dl>
  </details>

  <p class="dr-saved" id="saved-note" hidden></p>

  <div id="doctor" data-base={BASE}>
    <label for="pkg" class="label-caps pkg-label">Your package.json</label>
    <p class="meta" id="privacy">Runs entirely in your browser — nothing is uploaded; only dependency names and versions are read.</p>
    <textarea id="pkg" aria-describedby="privacy" spellcheck="false" placeholder='{"dependencies": {"react": "19.2.0", "zustand": "5.0.0", ...}}'></textarea>
    <p class="dr-gh">
      <label for="gh" class="label-caps">or fetch it from a public GitHub repo</label>
      <span class="dr-gh-row">
        <input id="gh" type="text" spellcheck="false" autocomplete="off" placeholder="owner/repo — or a github.com link to a folder" />
        <button id="gh-go" type="button" class="btn ghost">Fetch</button>
      </span>
    </p>
    <p class="dr-actions">
      <button id="run" type="button">Check</button>
      <label class="btn ghost file-btn">Load a file<input id="file" class="sr-only" type="file" accept=".json,application/json" /></label>
      <button id="sample" type="button" class="btn ghost">Try the sample</button>
      <span class="meta">sample: a fictional, outdated React Native app</span>
    </p>
    <p class="dr-actions" id="exports" hidden>
      <button id="save" type="button">Save as my project</button>
      <button id="share" type="button" class="btn ghost">Copy share link</button>
      <button id="copy" type="button" class="btn ghost">Copy report</button>
      <button id="download" type="button" class="btn ghost">Download .md</button>
      <span id="export-status" class="meta" role="status"></span>
    </p>
    <div id="out" aria-live="polite"></div>
  </div>

  <script>
    import { analyze, stageOf, depsOf, hostOf, matchDetector, SAMPLE } from '../lib/doctor-core.js';
    import { load, save, slimPkg, fitOf, fitIn, urgencyLabel, actNow, SEVERE } from '../lib/project.js';
    import { encodeReport, decodeReport, reportFromHash, parseRepo, repoLabel, fetchManifest } from '../lib/share.js';

    const root = document.getElementById('doctor');
    const BASE = root.dataset.base || '/';
    const $ = (id) => document.getElementById(id);
    const out = $('out');
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const clip = (s, n) => (s.length > n ? s.slice(0, n) + '…' : s);
    const entryUrl = (slug) => `${BASE}entries/${slug}/`;
    const safeUrl = (u) => (/^https?:\/\//i.test(u) ? u : null);
    const migrateUrl = (slug) => `${entryUrl(slug)}#migrate`;
    const CLI = ['npx -y @heart-it/react-brain doctor .', 'npx -y @heart-it/react-brain migrate .', 'npx -y @heart-it/react-brain review . --ci'];

    // corpus tables: fetched once, on demand
    let dataPromise = null;
    const loadData = () => (dataPromise ||= fetch(`${BASE}doctor-data.json`).then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    }).catch((err) => { dataPromise = null; throw err; }));

    let report = null;   // { md, name, pkg, a, data }
    let source = null;   // the GitHub repo the manifest came from, kept with a saved project
    const fitText = (f) => `${f[0]} ${fitOf(f).label}`;

    function render(pkg, data) {
      const a = analyze(pkg, data);
      const urg = urgencyLabel;
      const stage = stageOf(pkg);
      const { caps } = data;
      const md = [`# react-brain doctor — ${a.name}`, '',
        `platform: ${a.platform} · stage (guess): ${stage} · ${a.depCount} deps · corpus v${data.v}, verified ${data.verified}`, ''];

      const tally = { '✓': 0, '~': 0, '↗': 0 };
      for (const f of a.fits) tally[f.fit[0]]++;

      // ── summary: fit (review) and urgency (act now / plan) are independent axes ──
      const nAct = a.steps.filter(actNow).length;
      const nPlan = a.steps.length - nAct;
      const nReview = tally['↗'];
      const deps = Object.keys(depsOf(pkg));
      const nMatched = deps.filter((n) => { const d = matchDetector(n, data.detectors); return d && caps[d[1]]; }).length;
      // already ordered unblocked-first then by urgency; stable re-sort makes the act-now steps lead
      const next = [...a.steps].sort((x, y) => (actNow(x) ? 0 : 1) - (actNow(y) ? 0 : 1)).slice(0, 3);
      const stepLine = (s) => `${s.name}@${s.installed} → ${s.to}`;

      let html = `<p class="dr-context"><strong>${esc(a.name)}</strong> · ${esc(a.platform)} · stage (a guess from the manifest): ${esc(stage)} · ${a.depCount} deps · ${a.fits.length} choices found</p>`;

      html += '<section class="dr-summary" aria-labelledby="summary-h"><h2 id="summary-h">Summary</h2><dl class="dr-counts">' +
        `<div><dt>Fix now</dt><dd class="dr-n">${nAct}</dd><dd class="meta">dead or deprecated, nothing blocking</dd></div>` +
        `<div><dt>Plan to upgrade</dt><dd class="dr-n">${nPlan}</dd><dd class="meta">a better option or a newer version exists</dd></div>` +
        `<div><dt>Worth a look</dt><dd class="dr-n">${nReview}</dd><dd class="meta">differs from our pick — not necessarily wrong</dd></div>` +
        '</dl>' +
        `<p class="meta dr-note">${a.gaps.length} topic${a.gaps.length === 1 ? '' : 's'} not decided yet · ` +
        `${nMatched} of ${deps.length} dependencies matched a topic we cover — the rest are not judged.</p>`;
      md.push('## Summary', '',
        `- fix now: ${nAct} (dead or deprecated, nothing blocking)`,
        `- plan to upgrade: ${nPlan} (a better option or a newer version exists)`,
        `- worth a look: ${nReview} (differs from our pick — not necessarily wrong)`,
        `- not decided yet: ${a.gaps.length}`,
        `- ${nMatched} of ${deps.length} dependencies matched a topic we cover — the rest are not judged`, '');

      html += '<h3 id="next-h">Do these first</h3>';
      md.push('### Do these first', '');
      if (next.length) {
        html += '<ol class="rows dr-next">' + next.map((s) =>
          `<li><p class="f-what"><strong>${esc(stepLine(s))}</strong> <span class="meta">${s.blocked ? 'blocked' : esc(urg(s.urgency))}</span></p>` +
          `<p class="f-why">${esc(clip(s.why, 200))}</p>` +
          `<p class="meta f-facts"><a href="${entryUrl(s.slug)}">our pick</a> · <a href="${migrateUrl(s.slug)}">upgrade path</a></p></li>`).join('') +
          '</ol>';
        next.forEach((s, i) => md.push(`${i + 1}. **${stepLine(s)}** (${s.blocked ? 'blocked' : urg(s.urgency)}) — ${s.why}`,
          `   - our pick: ${location.origin}${entryUrl(s.slug)} · upgrade path: ${location.origin}${migrateUrl(s.slug)}`));
      } else {
        html += '<p class="muted">Nothing to upgrade from your installed versions.</p>';
        md.push('Nothing to upgrade from the installed versions.');
      }
      html += '</section>';
      md.push('');

      // ── fit ──
      html += '<h2 id="fit">Your choices</h2>';
      if (a.fits.length) {
        html += `<p class="meta"><span class="mark-ok">✓ ${tally['✓']} match our pick</span> · <span class="mark-warn">~ ${tally['~']} fit some contexts</span> · <span class="mark-dim">↗ ${tally['↗']} worth a look</span></p>`;
        html += '<div class="tbl wide"><table><thead><tr><th scope="col">topic</th><th scope="col">you use</th><th scope="col">vs our pick</th><th scope="col">our pick</th></tr></thead><tbody>';
        md.push('## Your choices', '', '| topic | you use | vs our pick |', '|---|---|---|');
        for (const f of a.fits) {
          const def = caps[f.id]?.def || '';
          const t = caps[f.id]?.topic || f.slug;
          const fo = fitIn(f, a.steps);
          html += `<tr><td><a href="${entryUrl(f.slug)}">${esc(t)}</a></td>` +
            `<td>${esc(f.choice)}</td><td><span class="${fo.cls}">${esc(fo === fitOf(f.fit) ? fitText(f.fit) : `✗ ${fo.label}`)}</span></td>` +
            `<td class="muted">${esc(clip(def, 160))}</td></tr>`;
          md.push(`| ${t} | ${f.choice} | ${fo === fitOf(f.fit) ? fitText(f.fit) : `✗ ${fo.label}`} |`);
        }
        html += '</tbody></table></div>';
        md.push('');
      } else {
        html += '<p class="muted">No dependency matched a topic we cover.</p>';
      }

      // ── findings: migration steps ──
      html += '<h2 id="findings">To fix</h2>';
      md.push('## To fix', '');
      if (a.steps.length) {
        html += '<p class="muted dr-note">Your installed versions checked against known upgrade paths — unblocked first, most urgent first.</p><div class="rows dr-findings">';
        for (const s of a.steps) {
          const severe = SEVERE.has(s.urgency);
          const glyph = s.blocked ? '⛔' : severe ? '✗' : '→';
          const applies = s.below ? `${s.pkg} < ${s.below}` : `all versions of ${s.pkg}`;
          const receipts = (s.receipts || []).map(safeUrl).filter(Boolean);
          html += '<div>' +
            `<p class="f-what"><span class="${severe && !s.blocked ? 'mark-warn' : 'mark-dim'}" aria-hidden="true">${glyph}</span> ` +
              `<strong>${esc(s.name)}</strong><span class="meta">@${esc(s.installed)}</span> → ${esc(s.to)}</p>` +
            `<p class="meta f-facts"><strong class="${severe ? 'mark-warn' : 'mark-dim'}">${esc(urg(s.urgency))}</strong> · effort ${esc(s.effort)} · applies to: ${esc(applies)}</p>` +
            `<p class="f-why">${esc(s.why)}</p>` +
            (s.blocked ? `<p class="f-why"><strong>⛔ blocked by</strong> ${esc(s.blocked)} — do that step first</p>` : '') +
            `<p class="meta f-facts">sources: ${receipts.length
              ? receipts.map((u) => `<a href="${esc(u)}" rel="noopener">${esc(hostOf(u))}</a>`).join(' · ')
              : 'none recorded'} · <a href="${entryUrl(s.slug)}">our pick</a> · <a href="${migrateUrl(s.slug)}">upgrade path</a></p>` +
            '</div>';
          md.push(`- ${glyph} **${s.name}@${s.installed} → ${s.to}** — ${urg(s.urgency)}, effort ${s.effort}, applies to: ${applies}`,
            `  - why: ${s.why}`,
            ...(s.blocked ? [`  - blocked by: ${s.blocked}`] : []),
            ...(receipts.length ? [`  - sources: ${receipts.join(' · ')}`] : []),
            `  - our pick: ${location.origin}${entryUrl(s.slug)} · upgrade path: ${location.origin}${migrateUrl(s.slug)}`);
        }
        html += '</div>';
      } else {
        html += '<p class="muted">Nothing to fix from your installed versions.</p>';
        md.push('Nothing to fix from the installed versions.');
      }
      md.push('');

      // ── gaps ──
      html += '<h2 id="gaps">Not decided yet</h2>';
      md.push('## Not decided yet', '');
      if (a.gaps.length) {
        html += '<p class="muted dr-note">Topics most apps need, with nothing detected. It may be built in or not apply to you; here is our pick if you need one.</p><div class="rows">';
        for (const id of a.gaps) {
          const cap = caps[id];
          html += `<div><p class="gap-what"><a href="${entryUrl(cap.slug)}"><strong>${esc(cap.topic || cap.slug)}</strong></a> <span class="meta">nothing detected</span></p>` +
            `<p class="muted gap-def">our pick: ${esc(clip(cap.def, 180))}</p></div>`;
          md.push(`- ${cap.topic || cap.slug}: nothing detected`);
        }
        html += '</div>';
      } else {
        html += '<p class="muted">Every topic most apps need has something detected.</p>';
        md.push('Every topic most apps need has something detected.');
      }
      // ── continue locally ──
      const cliWhy = 'The CLI reads your source too: it adds the legacy-API scan, source-level signals and a sequenced migration plan. ' +
        'Run migrate when you are ready to do the work; run review --ci in CI to fail a build on new drift.';
      html += '<section class="dr-local" aria-labelledby="local-h"><h2 id="local-h">Go deeper in your terminal</h2>' +
        `<pre class="no-copy"><code>${CLI.map(esc).join('\n')}</code></pre><p class="muted dr-note">${esc(cliWhy)}</p></section>`;
      md.push('## Go deeper in your terminal', '', '```sh', ...CLI, '```', '', cliWhy, '',
        `Generated in the browser by ${location.origin}${BASE}doctor/`);

      out.innerHTML = html;
      addCopy(out.querySelector('.dr-local pre'));
      report = { md: md.join('\n'), name: a.name, pkg, a, data };
      $('exports').hidden = false;
      $('export-status').textContent = '';
      const saved = load();
      $('save').textContent = saved?.name === a.name ? 'Update my project' : 'Save as my project';
      out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Base.astro adds copy buttons only to <pre> present at load; this one is rendered later
    function addCopy(pre) {
      const text = CLI.join('\n');
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'copy-btn'; b.textContent = 'copy';
      b.setAttribute('aria-label', 'Copy commands to clipboard');
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); b.textContent = '✓'; }
        catch { b.textContent = '✗'; }
        setTimeout(() => (b.textContent = 'copy'), 1400);
      });
      pre.appendChild(b);
    }

    async function run() {
      let pkg;
      try { pkg = JSON.parse($('pkg').value); }
      catch { out.innerHTML = '<p class="err">That is not valid JSON.</p>'; return; }
      if (!pkg || typeof pkg !== 'object' || !Object.keys(depsOf(pkg)).length) {
        out.innerHTML = '<p class="err">No dependencies found — paste a package.json with <code>dependencies</code> or <code>devDependencies</code>.</p>';
        return;
      }
      const btn = $('run');
      btn.disabled = true;
      out.setAttribute('aria-busy', 'true');
      out.innerHTML = '<p class="meta">loading the corpus tables…</p>';
      try {
        render(pkg, await loadData());
      } catch (err) {
        out.innerHTML = `<p class="err">Could not load the corpus data (${esc(err.message)}). Check your connection and try again.</p>`;
      } finally {
        btn.disabled = false;
        out.removeAttribute('aria-busy');
      }
    }

    $('run').addEventListener('click', run);

    // Save → the home page becomes this project's dashboard. Re-saving the same app
    // says what changed since the last check.
    $('save').addEventListener('click', () => {
      if (!report) return;
      const r = save(report.pkg, report.a, report.data.detectors, source);
      if (!r) { status('could not save — this browser blocks storage'); return; }
      document.documentElement.classList.add('has-project');
      const was = r.prev?.last, now = r.project.last;
      const delta = was ? [['to fix now', now.act - was.act], ['to plan', now.plan - was.plan]]
        .filter(([, d]) => d).map(([w, d]) => `${Math.abs(d)} ${d < 0 ? 'fewer' : 'more'} ${w}`).join(', ') : '';
      const note = $('saved-note');
      note.innerHTML = `Saved <strong>${esc(r.project.name)}</strong> in this browser${was ? ` — since the last check: ${esc(delta || 'no change')}` : ''}. ` +
        `<a href="${BASE}">Open your dashboard →</a>`;
      note.hidden = false;
      $('save').textContent = 'Update my project';
      note.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // a hand-edited manifest no longer comes from the repo it was fetched from
    $('pkg').addEventListener('input', () => { source = null; });

    // GitHub: the public repo's package.json, straight from raw.githubusercontent.com
    async function fromGitHub() {
      const r = parseRepo($('gh').value);
      if (!r) { out.innerHTML = '<p class="err">Use owner/repo, or a github.com link to the repo or a folder in it.</p>'; return; }
      const btn = $('gh-go');
      btn.disabled = true;
      out.innerHTML = `<p class="meta">fetching ${esc(repoLabel(r))}/package.json…</p>`;
      try {
        const pkg = await fetchManifest(r);
        $('pkg').value = JSON.stringify(pkg, null, 2);
        source = r;
        await run();
      } catch (err) {
        out.innerHTML = `<p class="err">Could not fetch ${esc(repoLabel(r))}: ${esc(err.message)}</p>`;
      } finally { btn.disabled = false; }
    }
    $('gh-go').addEventListener('click', fromGitHub);
    $('gh').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); fromGitHub(); } });

    // Share: the manifest rides in the link's #fragment — no server ever sees it
    $('share').addEventListener('click', async () => {
      if (!report) return;
      try {
        const url = `${location.origin}${BASE}doctor/#r=${await encodeReport(slimPkg(report.pkg))}`;
        await navigator.clipboard.writeText(url);
        status('share link copied ✓');
      } catch { status('copy failed'); }
    });

    // Opening: a shared link wins; otherwise a saved project re-opens and is re-checked.
    (async () => {
      const note = $('saved-note');
      const token = reportFromHash();
      if (token) {
        try {
          const pkg = await decodeReport(token);
          $('pkg').value = JSON.stringify(pkg, null, 2);
          note.innerHTML = `A shared report for <strong>${esc(pkg.name || 'an app')}</strong> — the app's dependency list is inside the link itself, nothing was uploaded. ` +
            'Save it as your project to keep it.';
          note.hidden = false;
          return run();
        } catch { note.innerHTML = '<span class="err">This share link is damaged — ask for it again.</span>'; note.hidden = false; return; }
      }
      const saved = load();
      if (saved?.pkg) {
        $('pkg').value = JSON.stringify(saved.pkg, null, 2);
        source = saved.source || null;
        if (source) $('gh').value = repoLabel(source);
        note.innerHTML = `Showing your saved project <strong>${esc(saved.name)}</strong> (checked ${esc(saved.savedAt || 'earlier')}${source ? ` from ${esc(repoLabel(source))}` : ''}). ` +
          (source ? '<button type="button" class="linkish" id="gh-refresh">fetch the latest from GitHub</button>, or paste' : 'Paste') +
          ' a new <code>package.json</code> to check another app.';
        note.hidden = false;
        $('gh-refresh')?.addEventListener('click', fromGitHub);
        run();
      }
    })();
    $('sample').addEventListener('click', () => {
      $('pkg').value = JSON.stringify(SAMPLE, null, 2);
      source = null;
      run();
    });
    $('file').addEventListener('change', async (ev) => {
      const file = ev.target.files[0];
      if (!file) return;
      $('pkg').value = await file.text();
      source = null;
      run();
    });

    const status = (msg) => {
      $('export-status').textContent = msg;
      setTimeout(() => { if ($('export-status').textContent === msg) $('export-status').textContent = ''; }, 2000);
    };
    $('copy').addEventListener('click', async () => {
      if (!report) return;
      try { await navigator.clipboard.writeText(report.md); status('copied ✓'); }
      catch { status('copy failed — use Download .md'); }
    });
    $('download').addEventListener('click', () => {
      if (!report) return;
      const url = URL.createObjectURL(new Blob([report.md], { type: 'text/markdown' }));
      const a = Object.assign(document.createElement('a'), {
        href: url, download: `react-brain-doctor-${report.name.replace(/[^\w.-]+/g, '-')}.md`,
      });
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  </script>
</Base>

<style>
  .dr-legend { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: .6rem 0; margin: 1rem 0 1.4rem; }
  .dr-legend summary { cursor: pointer; min-height: 24px; padding-block: var(--sp-1); }
  .dr-legend dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1rem; margin: var(--sp-2) 0 0; font-size: var(--fs-sm); }
  .dr-saved { border-left: 2px solid var(--accent); padding: var(--sp-2) var(--sp-3); background: var(--card); border-radius: var(--radius-sm); font-size: var(--fs-sm); max-width: none; }
  .dr-gh { display: flex; flex-direction: column; gap: var(--sp-1); margin: var(--sp-3) 0; }
  .dr-gh-row { display: flex; gap: var(--sp-2); max-width: 34rem; }
  #gh { flex: 1; min-width: 0; background: var(--code-bg); border: 1px solid var(--border-control); border-radius: var(--radius-sm); padding: var(--sp-2) var(--sp-3); font: 400 var(--fs-sm) var(--font-mono); }
  .pkg-label { display: block; margin-block-end: var(--sp-2); }
  #privacy { margin: 0 0 var(--sp-2); }
  .file-btn { position: relative; cursor: pointer; margin: 0; }
  .file-btn:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dr-legend dt { font-family: var(--font-mono); color: var(--muted); }
  .dr-legend dd { margin: 0; max-width: var(--measure); }
  @media (max-width: 600px) {
    .dr-legend dl { grid-template-columns: 1fr; }
    .dr-legend dd { margin-bottom: .4rem; }
  }
  .dr-actions { display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; }
  #out :global(.dr-context) { font-family: var(--font-mono); font-size: var(--fs-sm); overflow-wrap: anywhere; }
  #out :global(.dr-note) { font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.gap-what) { margin: 0; }
  #out :global(.gap-def) { margin: var(--sp-1) 0 0; font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.dr-findings p) { margin: 0; }
  #out :global(.dr-findings p + p) { margin-top: .3rem; }
  #out :global(.f-what) { overflow-wrap: anywhere; }
  #out :global(.f-why) { font-size: var(--fs-sm); max-width: var(--measure); }
  #out :global(.f-facts) { overflow-wrap: anywhere; }
