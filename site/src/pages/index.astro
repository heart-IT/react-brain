---
// Home. Two states, chosen in the browser before first paint (Base.astro adds
// html.has-project when a project is saved — see lib/project.js):
//   guest   → one promise, two actions, a real sample report, four tasks
//   project → that project's dashboard: what to fix, what it chose, what is undecided
// Everything a guest sees is static; the dashboard is rendered client-side from
// the saved manifest × doctor-data.json with the same analyze() as the doctor page.
import Base from '../layouts/Base.astro';
import { corpus, doctorData, siteMeta, href, BASE } from '../lib/corpus.js';
import { analyze, SAMPLE, hostOf } from '../lib/doctor-core.js';
import { fitOf, urgencyLabel } from '../lib/project.js';
const { entries } = corpus();
const m = siteMeta();

// ── the visual anchor: a REAL doctor run on the sample manifest, computed at build
// time with the same functions the doctor page uses (lib/doctor-core.js) ──
const demo = analyze(SAMPLE, doctorData());
const finding = demo.steps.find((s) => !s.blocked);
// fit rows: skip domains the finding already covers so the demo shows breadth
const urgentSlugs = new Set(demo.steps.filter((s) => ['dead', 'deprecated', 'superseded'].includes(s.urgency)).map((s) => s.slug));
const fitRows = demo.fits.filter((f) => !urgentSlugs.has(f.slug)).slice(0, 3);
const clip = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
const fitCls = (f) => (f.startsWith('✓') ? 't-ok' : f.startsWith('~') ? 't-warn' : 't-dim');
const fitGlyph = (f) => `${f[0]} ${fitOf(f).label}`;
const moreFindings = demo.steps.length - (finding ? 1 : 0);
const nextSlug = finding?.slug ?? demo.fits[0]?.slug ?? 'state';
// Rendered as one HTML string: JSX expressions inside <pre> lose their whitespace.
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const demoHtml = [
  `<span class="t-p">❯</span> check ${esc(demo.name)}/package.json`,
  '',
  `<span class="t-dim">${esc(demo.name)} · ${demo.platform} · ${demo.depCount} deps · ${demo.fits.length} choices found</span>`,
  '',
  ...fitRows.map((f) => `  ${f.slug.padEnd(12)} ${esc(clip(f.choice, 18).padEnd(18))} <span class="${fitCls(f.fit)}">${esc(fitGlyph(f.fit))}</span>`),
  ...(finding ? [
    '',
    `  <span class="t-warn">✗ ${esc(urgencyLabel(finding.urgency))}</span>  ${esc(finding.name)} ${esc(finding.installed)}`,
    // ≤ 56 columns so the widest line fits the hero column without a scrollbar
    `     → ${esc(clip(finding.to, 48))}`,
    `     <span class="t-dim">effort ${esc(finding.effort)} · source:</span> ` +
      (finding.receipts[0] ? `<a href="${esc(finding.receipts[0])}" rel="noopener">${esc(hostOf(finding.receipts[0]))}</a>` : '<span class="t-dim">none</span>'),
  ] : []),
  '',
  `<span class="t-dim">+ ${moreFindings} more to fix · ${demo.gaps.length} not decided yet</span>`,
  `<span class="t-p">next:</span> <a href="${href(`entries/${nextSlug}/`)}">entries/${nextSlug}</a>`,
].join('\n');

const cal = m.calibration;
const tasks = [
  { to: 'doctor/', label: 'I have an app', why: 'paste package.json — what to fix, what to keep, what to decide' },
  { to: 'stack/?platform=react', label: 'New React app', why: 'pick a web stack from what you are building' },
  { to: 'stack/?platform=react-native', label: 'New React Native app', why: 'Expo or bare, with the reason for each pick' },
  { to: 'libraries/', label: 'Picking a library', why: `${m.libraries} packages, each mapped to the question it answers` },
];
const recent = [...entries].sort((a, b) => String(b.updated).localeCompare(String(a.updated))).slice(0, 4);
---
<Base>
  <div id="dash" class="project-only" data-base={BASE} data-pagefind-ignore aria-live="polite">
    <p class="meta">loading your project…</p>
  </div>

  <section class="hero home guest-only" aria-labelledby="home-h1">
    <div>
      <p class="label-caps eyebrow">for teams shipping React &amp; React Native</p>
      <h1 id="home-h1">React decisions, with receipts.<span class="blink" aria-hidden="true">▊</span></h1>
      <p class="sub">Paste your <code>package.json</code>: see what to fix, what to keep and what is still
      undecided. Every answer links to the dated, primary-source evidence behind it.</p>
      <p class="ctas">
        <a class="btn" href={href('doctor/')}>Check my app →</a>
        <a class="btn ghost" href={href('stack/')}>Start a new app</a>
      </p>
      <p class="meta trust">{m.decisions} topics · {m.readings} sources checked{cal && <Fragment> · <a href={href('scorecard/')} title={`${cal.held} held, ${cal.weakened} weakened, ${cal.overturned} overturned of ${cal.graded} graded high-confidence calls`}>{cal.score}% of past calls held up</a></Fragment>} · <a href={href('methodology/')}>how we know →</a></p>
    </div>

    <figure class="demo">
      <div class="term">
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>sample report</span></div>
        <pre class="no-copy" set:html={demoHtml}></pre>
      </div>
      <figcaption class="meta">a fictional app ({demo.name}) · generated at build from the corpus · <a href={href('doctor/')}>check yours →</a></figcaption>
    </figure>
  </section>

  <section class="guest-only" aria-labelledby="h-tasks">
    <h2 id="h-tasks">What are you doing?</h2>
    <ul class="tasks">
      {tasks.map((t) => (
        <li><a href={href(t.to)}><span class="t-label">{t.label}</span><span class="t-why">{t.why}</span></a></li>
      ))}
    </ul>
  </section>

  <div class="below">
    <section aria-labelledby="h-recent">
      <h2 id="h-recent">Recently re-checked</h2>
      <ul class="rows plain">
        {recent.map((e) => (
          <li><a class="row" href={href(`entries/${e.slug}/`)}>
            <span class="row-title">{e.topic}</span> <span class="meta">checked {String(e.updated)}</span>
          </a></li>
        ))}
      </ul>
      <p class="meta"><a href={href('entries/')}>all {m.decisions} topics →</a></p>
    </section>
    <section aria-labelledby="h-quick">
      <h2 id="h-quick">In your terminal or agent</h2>
      <pre><span class="t-p">$</span> npx -y @heart-it/react-brain doctor .</pre>
      <p class="muted small">Reads your source too, not just the manifest. For coding agents, an MCP server with {m.mcpTools} tools:</p>
      <pre><span class="t-p">$</span> claude mcp add react-brain -- npx -y @heart-it/react-brain mcp</pre>
    </section>
  </div>

  <script>
    import { analyze } from '../lib/doctor-core.js';
    import { load, forget, save, setDone, markSeen, fitIn, urgencyLabel, actNow, stepKey, summarize } from '../lib/project.js';
    import { encodeReport, fetchManifest, repoLabel } from '../lib/share.js';

    const dash = document.getElementById('dash');
    const BASE = dash.dataset.base || '/';
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const entryUrl = (slug) => `${BASE}entries/${slug}/`;
    const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
    let p = load();
    const today = new Date().toISOString().slice(0, 10);

    const leave = () => { forget(); document.documentElement.classList.remove('has-project'); };

    function render(data) {
      const a = analyze(p.pkg, data);
      const n = summarize(a);
      const done = p.done || {};
      const steps = [...a.steps].sort((x, y) => (done[stepKey(x)] ? 1 : 0) - (done[stepKey(y)] ? 1 : 0));
      const nDone = a.steps.filter((s) => done[stepKey(s)]).length;
      const topic = (id) => data.caps[id]?.topic || data.caps[id]?.slug || id;

      // since the last visit: new to-dos, and this project's topics re-checked in the corpus
      const keys = a.steps.map(stepKey);
      const fresh = p.seenAt ? {
        steps: p.known ? a.steps.filter((s) => !p.known.includes(stepKey(s))) : [],
        topics: [...new Set([...a.fits.map((f) => f.id), ...a.gaps, ...a.steps.map((s) => s.entry)])]
          .filter((id) => data.caps[id]?.updated > p.seenAt),
      } : null;

      let html = `<p class="label-caps">your project · saved in this browser</p>` +
        `<h1 class="dash-h">${esc(a.name)}</h1>` +
        `<p class="meta">${esc(a.platform)} · ${esc(p.stage || '')} · ${a.depCount} deps · checked ${esc(p.savedAt || 'earlier')}` +
          `${p.source ? ` from <a href="https://github.com/${esc(p.source.owner)}/${esc(p.source.repo)}" rel="noopener">${esc(repoLabel(p.source))}</a>` : ''}</p>` +
        '<dl class="dash-counts">' +
        `<div><dt>Fix now</dt><dd class="dash-n">${n.act}</dd></div>` +
        `<div><dt>Plan to upgrade</dt><dd class="dash-n">${n.plan}</dd></div>` +
        `<div><dt>Worth a look</dt><dd class="dash-n">${n.review}</dd></div>` +
        `<div><dt>Not decided yet</dt><dd class="dash-n">${n.gaps}</dd></div>` +
        '</dl>' +
        '<p class="ctas">' + (p.source
          ? '<button type="button" id="gh-refresh">Re-check from GitHub</button>'
          : `<a class="btn" href="${BASE}doctor/">Re-check my app</a>`) +
        ' <button type="button" class="ghost" id="share">Copy share link</button>' +
        ` <a class="btn ghost" href="${BASE}watch/">Get alerts</a>` +
        ' <button type="button" class="linkish" data-forget>forget this project</button></p>' +
        '<p class="meta" id="dash-status" role="status"></p>';

      if (fresh && (fresh.steps.length || fresh.topics.length)) {
        html += `<section class="since" aria-labelledby="since-h"><h2 id="since-h">Since your last visit <span class="meta">${esc(p.seenAt)}</span></h2><ul class="rows plain">` +
          fresh.steps.map((s) => `<li><span class="mark-warn">new to do</span> <strong>${esc(s.name)}</strong> → ${esc(s.to)} <span class="meta">${esc(urgencyLabel(s.urgency))}</span></li>`).join('') +
          // a big harvest re-checks most topics at once: name a few, count the rest
          fresh.topics.slice(0, 5).map((id) => `<li><span class="mark-ok">re-checked</span> <a href="${entryUrl(data.caps[id].slug)}">${esc(topic(id))}</a> <span class="meta">${esc(data.caps[id].updated)}</span></li>`).join('') +
          (fresh.topics.length > 5 ? `<li class="meta">and ${fresh.topics.length - 5} more of your topics re-checked — <a href="${BASE}changelog/">what changed</a></li>` : '') +
          '</ul></section>';
      }

      html += `<h2 id="todo-h">To do <span class="meta">${a.steps.length ? `${nDone} of ${a.steps.length} done` : ''}</span></h2>`;
      if (steps.length) {
        html += '<ul class="todo" aria-labelledby="todo-h">' + steps.map((s, i) => {
          const k = stepKey(s), id = `todo-${i}`;
          const tag = s.blocked ? 'blocked' : urgencyLabel(s.urgency);
          return `<li class="${done[k] ? 'is-done' : ''}"><input type="checkbox" id="${id}" data-key="${esc(k)}"${done[k] ? ' checked' : ''} />` +
            `<label for="${id}"><strong>${esc(s.name)}</strong> → ${esc(s.to)}</label>` +
            `<span class="meta todo-facts"><span class="${actNow(s) ? 'mark-warn' : 'mark-dim'}">${esc(tag)}</span> · effort ${esc(s.effort)} · <a href="${entryUrl(s.slug)}#migrate">how</a></span></li>`;
        }).join('') + '</ul>';
      } else {
        html += '<p class="muted">Nothing to upgrade from your installed versions.</p>';
      }

      html += '<h2>Your choices</h2>';
      html += a.fits.length ? '<ul class="rows plain">' + a.fits.map((f) => {
        const fo = fitIn(f, a.steps);
        return `<li><a class="row" href="${entryUrl(f.slug)}"><span class="row-title">${esc(topic(f.id))}</span> ` +
          `<span class="muted">${esc(f.choice)}</span> <span class="meta ${fo.cls}">${esc(fo.label)}</span></a></li>`;
      }).join('') + '</ul>' : '<p class="muted">No dependency matched a topic we cover.</p>';

      if (a.gaps.length) {
        html += '<h2>Not decided yet</h2><p class="muted small">Nothing detected for these. It may be built in or not apply to you.</p><ul class="rows plain">' +
          a.gaps.map((id) => `<li><a class="row" href="${entryUrl(data.caps[id].slug)}"><span class="row-title">${esc(topic(id))}</span> <span class="meta">see our pick →</span></a></li>`).join('') + '</ul>';
      }
      dash.innerHTML = html;
      dash.querySelector('[data-forget]').addEventListener('click', leave);
      markSeen(keys, today);
      const say = (m) => { const el = dash.querySelector('#dash-status'); el.textContent = m; setTimeout(() => { if (el.textContent === m) el.textContent = ''; }, 2400); };
      dash.querySelector('#share').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(`${location.origin}${BASE}doctor/#r=${await encodeReport(p.pkg)}`); say('share link copied ✓ — the dependency list is inside the link, nothing is uploaded'); }
        catch { say('copy failed'); }
      });
      dash.querySelector('#gh-refresh')?.addEventListener('click', async (ev) => {
        ev.target.disabled = true;
        say(`fetching ${repoLabel(p.source)}/package.json…`);
        try {
          const pkg = await fetchManifest(p.source);
          const r = save(pkg, analyze(pkg, data), data.detectors, p.source);
          if (!r) throw new Error('this browser blocks storage');
          p = r.project;
          render(data);
          dash.querySelector('#dash-status').textContent = 'updated from GitHub ✓';
        } catch (err) { ev.target.disabled = false; say(`could not fetch: ${err.message}`); }
      });
      for (const box of dash.querySelectorAll('.todo input')) box.addEventListener('change', () => {
        setDone(box.dataset.key, box.checked);
        box.closest('li').classList.toggle('is-done', box.checked);
        const left = dash.querySelectorAll('.todo input:checked').length;
        dash.querySelector('#todo-h .meta').textContent = `${left} of ${a.steps.length} done`;
      });
    }

    if (p?.name) {
      if (!p.pkg) {
        // loaded with the console's `load` before projects kept their manifest
        dash.innerHTML = `<p class="label-caps">your project · saved in this browser</p><h1 class="dash-h">${esc(p.name)}</h1>` +
          `<p class="muted">${plural(Object.keys(p.byEntry || {}).length, 'choice')} found. Re-check it once to get your to-do list.</p>` +
          `<p class="ctas"><a class="btn" href="${BASE}doctor/">Re-check my app</a> <button type="button" class="linkish" data-forget>forget this project</button></p>`;
        dash.querySelector('[data-forget]').addEventListener('click', leave);
      } else {
        fetch(`${BASE}doctor-data.json`).then((r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
          .then(render)
          .catch((err) => { dash.innerHTML = `<p class="err">Could not load the corpus data (${esc(err.message)}). Reload to try again.</p>`; });
      }
    }
  </script>
</Base>

<style>
  /* state switch: html.has-project is set in <head> before first paint */
  :global(html.has-project) .guest-only { display: none; }
  :global(html:not(.has-project)) .project-only { display: none; }

  .home { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  @media (max-width: 1100px) { .home { grid-template-columns: minmax(0, 1fr); gap: 1.8rem; } }
  .eyebrow { margin: 0; }
  .sub { color: var(--muted); max-width: var(--measure); }
  .ctas { display: flex; gap: .7rem; flex-wrap: wrap; align-items: center; margin-top: 1.4rem; }
  .hero .trust { margin-top: var(--sp-4); font-size: var(--fs-sm); }
  .trust a { color: var(--muted); }
  .trust a:hover { color: var(--accent); }

  .demo { margin: 0; min-width: 0; }
  .demo pre { white-space: pre; }
  .demo pre a { color: var(--accent); }
  .demo figcaption { text-align: center; margin-top: .5rem; }

  .tasks { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 0 2rem; }
  .tasks li { margin: 0; border-top: 1px solid var(--line); }
  .tasks a { display: block; padding: .7rem 0; text-decoration: none; }
  .tasks .t-label { display: block; font: 600 var(--fs-md) var(--font-head); color: var(--bright); }
  .tasks .t-why { display: block; color: var(--muted); font-size: var(--fs-sm); max-width: var(--measure); }
  .tasks a:hover .t-label { color: var(--accent); }

  .below { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr)); gap: 0 4rem; align-items: start; }
  .plain { list-style: none; padding: 0; }
  .plain .row { display: block; }
  .row-title { display: block; font-family: var(--font-head); font-weight: 600; color: var(--bright); }
  /* commands wrap at spaces instead of scrolling the half-width column */
  .below pre { white-space: pre-wrap; }
  .small { font-size: var(--fs-sm); max-width: var(--measure); }

  /* ── the project dashboard (rendered by the script above) ── */
  #dash :global(.dash-h) { margin-top: var(--sp-1); overflow-wrap: anywhere; }
  #dash :global(.dash-counts) { display: grid; grid-template-columns: repeat(4, 1fr); margin: var(--sp-6) 0 0; border-block: 1px solid var(--line); }
  #dash :global(.dash-counts > div) { padding: var(--sp-3) var(--sp-4); border-inline-start: 1px solid var(--line); }
  #dash :global(.dash-counts > div:first-child) { border-inline-start: 0; padding-inline-start: 0; }
  #dash :global(.dash-counts dt) { font: 500 var(--fs-xs) var(--font-mono); color: var(--muted); }
  #dash :global(.dash-counts dd) { margin: 0; }
  #dash :global(.dash-n) { font: 600 var(--fs-2xl)/1.2 var(--font-mono); color: var(--bright); font-variant-numeric: tabular-nums; }
  @media (max-width: 600px) {
    #dash :global(.dash-counts) { grid-template-columns: 1fr 1fr; }
    #dash :global(.dash-counts > div) { border-inline-start: 0; padding-inline: 0; }
  }
  #dash :global(.todo) { list-style: none; padding: 0; margin: 0; }
  #dash :global(.todo li) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .1rem var(--sp-3); align-items: baseline; margin: 0; padding: var(--sp-3) 0; border-top: 1px solid var(--line); }
  #dash :global(.todo input) { width: 24px; height: 24px; margin: 0; accent-color: var(--accent); align-self: start; }
  #dash :global(.todo label) { margin: 0; overflow-wrap: anywhere; cursor: pointer; }
  #dash :global(.todo-facts) { grid-column: 2; }
  #dash :global(.todo li.is-done label) { color: var(--muted); text-decoration: line-through; }
  #dash :global(.row .muted) { font-size: var(--fs-sm); }
  #dash :global(.since) { margin-top: var(--sp-6); border-left: 2px solid var(--accent); padding-left: var(--sp-4); }
  #dash :global(.since h2) { margin-top: 0; }
  #dash :global(.since li) { font-size: var(--fs-sm); overflow-wrap: anywhere; }
</style>
