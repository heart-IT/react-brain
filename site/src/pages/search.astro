---
import Base from '../layouts/Base.astro';
import { BASE, corpus, siteMeta, href } from '../lib/corpus.js';
// Full-text search over the BUILT site via Pagefind's JS API (pagefind.js — the
// index Pagefind writes into dist/pagefind/ after `astro build`). Results are
// rendered here rather than by Pagefind's prebuilt UI so they can be grouped by
// content type and carry honest loading / empty / no-results states. In
// `astro dev` the index doesn't exist yet; the page says so.
const m = siteMeta();
const { groups } = corpus();
const gl = (g) => g.label.split(' — ')[0].split(' (')[0].toLowerCase();
// "try:" suggestions on a miss — the three largest decision groups
const suggest = [...groups].sort((a, b) => b.entries.length - a.entries.length).slice(0, 3)
  .map((g) => ({ label: gl(g), url: href(`entries/#${g.id}`) }));
const EXAMPLES = ['zustand or jotai', 'expo router', 'react compiler'];
---
<Base title="Search">
  <h1>Search</h1>
  <form id="sform" class="sform" role="search" aria-label="Search the corpus" action={href('search/')} method="get">
    <label for="q" class="sr-only">Search decisions, readings and tools</label>
    <span class="prompt" aria-hidden="true">❯</span>
    <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="search or ask — “should I use zustand?”" aria-describedby="s-keys" aria-controls="results" />
  </form>
  <p id="s-keys" class="meta keys"><kbd>enter</kbd> open first result · <kbd>↓</kbd> move into results · <kbd>esc</kbd> clear · <kbd class="plat-key">⌘J</kbd> console</p>

  <div id="ask-out" hidden>
    <p class="label-caps ask-label">readings that answer this</p>
    <div class="rows" id="ask-rows"></div>
  </div>

  <p id="s-status" class="meta status" role="status" aria-live="polite"></p>

  <div id="s-empty" class="s-state">
    <p class="muted flush">Search {m.decisions} decisions, {m.readings} annotated readings, the tools and the methodology.</p>
    <p class="meta s-try">try: {EXAMPLES.map((x, i) => <>{i > 0 && ' · '}<a href={`?q=${encodeURIComponent(x)}`} data-example={x}>{x}</a></>)}</p>
    <p class="meta s-browse">or browse: {groups.map((g, i) => <>{i > 0 && ' · '}<a href={href(`entries/#${g.id}`)}>{gl(g)}</a></>)}</p>
  </div>
  <div id="s-none" class="s-state" hidden>
    <p class="flush">No results for <b id="s-none-q"></b>.</p>
    <p class="meta s-try">try: {suggest.map((s, i) => <>{i > 0 && ' · '}<a href={s.url}>{s.label}</a></>)} · or <a href={href('entries/')}>all decisions</a></p>
  </div>
  <p id="search-hint" class="muted" hidden>Search is generated at build time — run <code>npm run build &amp;&amp; npm run preview</code> to use it locally (in <code>astro dev</code> the index doesn't exist yet).</p>

  <section id="results" aria-label="Search results"></section>

  <script is:inline define:vars={{ BASE }}>
    const $ = (id) => document.getElementById(id);
    // the ⌘ glyph is Mac-only (Base.astro does the same for the header's kbds)
    if (!/Mac|iPhone|iPad/.test(navigator.platform))
      for (const k of document.querySelectorAll('kbd.plat-key')) k.textContent = k.textContent.replace('⌘', 'Ctrl ');
    const input = $('q'), status = $('s-status'), results = $('results');
    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const TYPES = [
      ['decision', 'decisions', (p) => p.startsWith('entries/') && p !== 'entries/'],
      ['reading', 'readings & newsletter', (p) => /^(reading|newsletter)\//.test(p)],
      ['tool', 'tools', (p) => /^(doctor|stack|decide|libraries|entries)\/$/.test(p) || p === 'entries/'],
      ['about', 'about & evidence', () => true],
    ];
    const typeOf = (url) => {
      const p = url.startsWith(BASE) ? url.slice(BASE.length) : url.replace(/^\//, '');
      return TYPES.find(([, , t]) => t(p.split('#')[0]))[0];
    };

    let pf = null, pfLoading = null;
    function loadPagefind() {
      pfLoading ||= import(`${BASE}pagefind/pagefind.js`).then(async (mod) => {
        await mod.options({ baseUrl: BASE, excerptLength: 26 });
        mod.init();
        pf = mod;
        return mod;
      });
      return pfLoading;
    }

    function show(state, q) {
      if (state !== 'results') shownQ = null;
      $('s-empty').hidden = state !== 'empty';
      $('s-none').hidden = state !== 'none';
      if (state === 'none') $('s-none-q').textContent = `“${q}”`;
      if (state !== 'results') results.innerHTML = '';
    }

    let seq = 0, shownQ = null;
    async function run(q) {
      const my = ++seq;
      q = q.trim();
      if (!q) { status.textContent = ''; show('empty'); return; }
      status.textContent = pf ? 'searching…' : 'loading the search index…';
      let mod;
      try { mod = await loadPagefind(); }
      catch { status.textContent = ''; show('hidden'); $('search-hint').hidden = false; return; }
      const res = await mod.search(q);
      if (my !== seq) return;                       // a newer query superseded this one
      if (!res || !res.results.length) { status.textContent = ''; show('none', q); return; }
      const data = await Promise.all(res.results.slice(0, 24).map((r) => r.data()));
      if (my !== seq) return;
      const byType = new Map(TYPES.map(([k, label]) => [k, { label, items: [] }]));
      for (const d of data) byType.get(typeOf(d.url)).items.push(d);
      results.innerHTML = [...byType.entries()].filter(([, g]) => g.items.length).map(([k, g]) => `
        <section class="s-group" aria-label="${esc(g.label)}">
          <p class="label-caps s-glabel">${esc(g.label)} <span class="s-n">${g.items.length}</span></p>
          <ol class="s-list">${g.items.map((d) => {
            const subs = (d.sub_results || []).filter((s) => s.url !== d.url && s.title !== d.meta?.title).slice(0, 2);
            const path = d.url.startsWith(BASE) ? d.url.slice(BASE.length) : d.url;
            return `<li><a class="s-link" href="${esc(d.url)}"><span class="s-title">${esc(d.meta?.title || path)}</span>${k === 'decision' ? `<span class="s-path meta">${esc(path.replace(/^entries\//, '').replace(/\/.*$/, ''))}</span>` : ''}</a>
              <p class="s-ex">${d.excerpt || ''}</p>
              ${subs.length ? `<p class="meta s-subs">${subs.map((s) => `<a href="${esc(s.url)}">§ ${esc(s.title)}</a>`).join(' · ')}</p>` : ''}</li>`;
          }).join('')}</ol>
        </section>`).join('');
      const total = res.results.length;
      status.textContent = `${total} result${total === 1 ? '' : 's'} for “${q}”${total > data.length ? ` · showing the top ${data.length}` : ''}`;
      show('results');
      shownQ = q;
    }

    // question routing above full-text: the console's `ask` scorer over the corpus's
    // reading annotations + claims (deterministic, same data island as the console)
    let RB = null;
    async function ask(qs) {
      const out = $('ask-out');
      if (!qs.trim()) { out.hidden = true; return; }
      if (!RB) { try { RB = await (await fetch(`${BASE}console-data.json`)).json(); } catch { return; } }
      const STOP = new Set('the a an is are was be my our your this that these of in on at to for and or but with without after before does do did how why what when where which it its as from by not no so if then than can could should would use using i we you'.split(' '));
      const toks = [...new Set(qs.toLowerCase().split(/\s+/).map((t) => t.replace(/[^\w-]/g, '')).filter((t) => t.length > 2 && !STOP.has(t)))];
      const stem = (t) => (t.length > 3 && t.endsWith('s') ? t.slice(0, -1) : t);
      const hits = (RB.readings || []).map((r) => {
        const text = `${r.title} ${r.what} ${r.claim || ''}`.toLowerCase();
        let sc = 0, h = 0;
        for (const t of toks) { const tf = text.split(stem(t)).length - 1; if (tf) { h++; sc += Math.min(tf, 3); } }
        return { r, sc, h };
      }).filter((x) => toks.length && x.h >= Math.min(2, toks.length)).sort((a, b) => b.sc - a.sc).slice(0, 3);
      out.hidden = !hits.length;
      $('ask-rows').innerHTML = hits.map(({ r }) => {
        const gist = r.claim || r.what || '';
        return `<div><a href="${esc(r.url)}" rel="noopener" class="ask-title">${esc(r.title)}</a>
          <a class="meta ask-slug" href="${BASE}entries/${esc(r.slug)}/">${esc(r.slug)}</a>
          <p class="muted ask-gist">${esc(gist.length > 260 ? gist.slice(0, 259) + '…' : gist)}</p></div>`;
      }).join('');
    }

    // keep ?q= in the address bar so a search is shareable and survives reload
    const syncUrl = (q) => {
      const u = new URL(location.href);
      if (q) u.searchParams.set('q', q); else u.searchParams.delete('q');
      history.replaceState(null, '', u);
    };
    let deb;
    input.addEventListener('input', () => {
      clearTimeout(deb);
      const v = input.value;
      if (!v.trim()) { run(''); ask(''); syncUrl(''); return; }
      deb = setTimeout(() => { run(v); ask(v); syncUrl(v.trim()); }, 220);
    });
    const links = () => [...results.querySelectorAll('a.s-link')];
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        if (input.value) { input.value = ''; input.dispatchEvent(new Event('input')); }
        input.blur();
      } else if (e.key === 'ArrowDown' && links().length) {
        e.preventDefault(); links()[0].focus();
      }
    });
    // Enter opens the first result (in displayed order); with none yet, run now
    $('sform').addEventListener('submit', async (e) => {
      e.preventDefault();
      clearTimeout(deb);
      const v = input.value.trim();
      if (v && shownQ !== v) { syncUrl(v); await Promise.all([run(v), ask(v)]); }
      const first = links()[0];
      if (first && input.value.trim() === v) location.href = first.href;
    });
    results.addEventListener('keydown', (e) => {
      const ls = links(), i = ls.indexOf(document.activeElement);
      if (i < 0) return;
      if (e.key === 'ArrowDown' && i < ls.length - 1) { e.preventDefault(); ls[i + 1].focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); (i > 0 ? ls[i - 1] : input).focus(); }
      else if (e.key === 'Escape') { e.preventDefault(); input.focus(); }
    });
    for (const a of document.querySelectorAll('[data-example]')) a.addEventListener('click', (e) => {
      e.preventDefault(); input.value = a.dataset.example; input.dispatchEvent(new Event('input')); input.focus();
    });

    // deep link: the header search form (and shared links) land here with ?q=
    const q0 = (new URLSearchParams(location.search).get('q') || '').trim();
    if (q0) { input.value = q0; run(q0); ask(q0); input.focus(); }
    else { show('empty'); loadPagefind().catch(() => { $('search-hint').hidden = false; $('s-empty').hidden = true; }); }
  </script>
</Base>

<style>
  .sform { display: flex; align-items: center; gap: .55rem; max-width: 40rem; margin: 1rem 0 0; background: var(--code-bg); border: 1px solid var(--border-control); border-radius: var(--radius-md); padding: .55rem .8rem; }
  .sform:focus-within { border-color: var(--accent); box-shadow: 0 0 0 2px var(--glow); }
  .sform input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 400 var(--fs-md) var(--font-mono); }
  .sform input:focus { outline: none; box-shadow: none; }
  .sform input::placeholder { color: var(--muted); }
  .keys { margin: .45rem 0 1.2rem; }
  .keys kbd { padding: 0 .3em; color: var(--fg); }   /* size, border and radius come from the global kbd rule */
  @media (hover: none) { .keys { display: none; } }
  #ask-out { margin: 0 0 1.4rem; }
  .ask-label { margin: 0 0 .3rem; color: var(--muted); }
  /* #ask-rows children are built in JS — :global so the scoped styles reach them */
  #ask-out :global(.ask-title) { font: 600 var(--fs-md)/1.4 var(--font-head); color: var(--bright); text-decoration: none; }
  #ask-out :global(.ask-title:hover) { color: var(--accent); }
  #ask-out :global(.ask-slug) { margin-inline-start: var(--sp-2); }
  /* both are the row's targets: ≥ 24px tall without moving the baseline */
  #ask-out :global(.ask-title), #ask-out :global(.ask-slug) { display: inline-block; padding-block: var(--sp-1); margin-block: calc(-1 * var(--sp-1)); }
  #ask-out :global(.ask-gist) { margin: var(--sp-1) 0 0; font-size: var(--fs-sm); max-width: var(--measure); }
  .flush { margin: 0; }
  .s-try { margin: var(--sp-2) 0 0; }
  .s-browse { margin: .3rem 0 0; }
  .status { min-height: 1.2em; margin: 0 0 .4rem; }
  .s-state { margin: .2rem 0 0; }
  :global(.s-group) { margin: 1.2rem 0 0; }
  :global(.s-glabel) { margin: 0 0 .2rem; }
  :global(.s-n) { color: var(--line-strong); margin-left: .3rem; }
  :global(.s-list) { list-style: none; padding: 0; margin: 0; }
  :global(.s-list > li) { margin: 0; padding: .75rem 0; border-top: 1px solid var(--line); min-width: 0; }
  :global(.s-link) { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .6rem; text-decoration: none; padding-block: 2px; }
  :global(.s-title) { color: var(--bright); font: 600 var(--fs-md)/1.4 var(--font-head); }
  :global(.s-link:hover .s-title), :global(.s-link:focus-visible .s-title) { color: var(--accent); }
  :global(.s-ex) { margin: .25rem 0 0; color: var(--muted); font-size: var(--fs-sm); max-width: var(--measure); overflow-wrap: anywhere; }
  :global(.s-ex mark) { background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); border-radius: 2px; padding: 0 .12em; }
  :global(.s-subs) { margin: .25rem 0 0; }
  :global(.s-subs a) { color: var(--muted); }
  :global(.s-subs a:hover) { color: var(--accent); }
</style>
