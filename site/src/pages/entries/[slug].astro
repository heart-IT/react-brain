---
// One decision page. Reading order is the decision itself, answer first:
// breadcrumb → h1 → one trust chip + date → your project's fit (when one is saved) →
// THE pick panel (the page's single visual anchor) → "how sure are we?" (collapsed:
// status, calibration, forecast, evidence counts) → other options → upgrade path →
// key facts + sources → reading → watching → full explanation → related → prev/next.
import Base from '../../layouts/Base.astro';
import { corpus, downloads, fmtDownloads, track, docHtml, href, GITHUB, census, revisions, scorecard, siteMeta } from '../../lib/corpus.js';
import { srcLabel, sourceType, relations, prevNext, groupOf, groupLabel, leadOption, clip, splitWhen, paragraphs, ageDays } from '../../lib/entry.js';
import { urgencyLabel } from '../../lib/project.js';

export function getStaticPaths() {
  return corpus().entries.map((e) => ({ params: { slug: e.slug }, props: { id: e.id } }));
}
const { id } = Astro.props;
const { byId } = corpus();
const e = byId[id];
const meta = siteMeta();
const dl = downloads();
const tr = track()[id];
const pkgs = (e.detect || []).filter((d) => !d.pkg.includes('*') && dl[d.pkg] != null);
const doc = docHtml(e);
// reading time for the collapsed essay: words of the rendered text at ~220 wpm
const docWords = doc ? doc.replace(/<[^>]*>/g, ' ').replace(/&[#a-z0-9]+;/gi, ' ').split(/\s+/).filter(Boolean).length : 0;
const docMinutes = Math.max(1, Math.round(docWords / 220));
const group = groupOf(e);
const rels = relations(e);
const { prev, next } = prevNext(e);
// calibration: what this confidence tier has actually earned on the public scorecard
const tier = scorecard()?.tiers?.[e.confidence];
// verification history: the dates this entry's file changed in git
const revs = revisions(id);
const when = e.recommend?.when || [];
const lead = leadOption(e);
const age = ageDays(e.updated, meta.built);
const nSources = e.sources?.length || 0, nReading = e.reading?.length || 0, nWatching = e.watching?.length || 0;

// per-option evidence: map option → detect label (fuzzy) → census adoption + npm downloads
const cen = census();
const agg = cen?.agg?.[id] || null;
const optEvidence = (e.options || []).map((o) => {
  const on = o.name.toLowerCase().replace(/\s*\(.*/, '');
  const d = (e.detect || []).find((x) => {
    const l = x.label.toLowerCase().replace(/\s*\(.*/, '');
    return l.length > 2 && (on.includes(l) || l.includes(on));
  });
  if (!d) return null;
  const ships = agg?.labels?.[d.label] ?? null;
  const wk = !d.pkg.includes('*') ? (dl[d.pkg] ?? null) : null;
  return ships != null || wk != null ? { ships, denom: agg?.denom ?? null, wk } : null;
});
const hasEvidence = optEvidence.some(Boolean);
const evText = (ev) => ev ? [
  ev.wk != null ? `${fmtDownloads(ev.wk)}/wk` : null,
  ev.ships != null ? `ships in ${ev.ships}/${ev.denom}` : null,
].filter(Boolean).join(' · ') : '';

// one plain-language trust signal in place of three badges (status · confidence ·
// forecast); the detail behind it is one click away in "How sure are we?"
const TRUST = {
  high: ['Strong pick', 'high confidence: well-evidenced and stable — safe to default to'],
  medium: ['Good default', 'medium confidence: sound default, but check the context notes'],
  low: ['Early call', 'low confidence: fast-moving or lightly vetted — prototype before committing'],
};
const [trustLabel, trustWhy] = TRUST[e.confidence] || TRUST.medium;
const REL_LABEL = { 'cited here': 'mentioned here', 'cites this': 'mentions this', 'same group': 'same area' };

const toc = [
  ['options', 'Options'],
  e.migrate?.length ? ['migrate', 'Upgrade path'] : null,
  e.note || nSources ? ['notes', 'Key facts'] : null,
  nReading ? ['reading', 'Read'] : null,
  nWatching ? ['watching', 'Watch'] : null,
  doc ? ['explanation', 'Full story'] : null,
  rels.length ? ['related', 'Related'] : null,
].filter(Boolean);
---
<Base title={e.topic} description={`${e.topic} — ${clip(e.recommend?.default, 150)}`} activeGroup={e.group}>
  <nav class="crumbs meta" aria-label="Breadcrumb" data-pagefind-ignore>
    <a href={href('entries/')}>Topics</a><span aria-hidden="true"> › </span><a href={href(`entries/#${e.group}`)}>{groupLabel(group) || e.group}</a><span aria-hidden="true"> › </span><span aria-current="page">{e.topic}</span>
  </nav>
  <h1>{e.topic}</h1>
  <p class="meta entry-meta" data-pagefind-ignore>
    <span><span class={`badge ${e.confidence}`} title={trustWhy}>{trustLabel}</span></span>
    {e.platforms?.length > 0 && <span>{e.platforms.join(' + ')}</span>}
    {e.updated && <span>checked <time datetime={String(e.updated)}>{String(e.updated)}</time></span>}
  </p>

  <p id="session-banner" class="session" data-pagefind-ignore hidden
    data-entry={e.id} data-def={e.recommend?.default || ''} data-when={JSON.stringify(when)}></p>

  <section class="rec-panel" aria-labelledby="rec-label">
    <p class="rec-label" id="rec-label" data-pagefind-ignore>our pick</p>
    <p class="rec-default">{e.recommend?.default}</p>
    {when.length > 0 && (
      <>
        <p class="rec-sub">unless your situation is different</p>
        <ul class="rec-when">
          {when.map((w) => { const { ctx, pick } = splitWhen(w); return (
            <li>{ctx ? <><span class="ctx">{ctx}</span> <span class="arrow" aria-hidden="true">→</span><span class="sr-only">: use</span> <span class="pick">{pick}</span></> : <span class="pick">{pick}</span>}</li>
          ); })}
        </ul>
      </>
    )}
    {e.confidence === 'low' && (
      <p class="rec-caveat"><strong>Low confidence</strong> — fast-moving or lightly-vetted domain: treat the pick as a vetted lead and prototype before committing.</p>
    )}
    <p class="meta rec-next" data-pagefind-ignore><a href={href(`decide/?entry=${e.id}`)}>Save this choice as a decision record →</a> · <a href={href('doctor/')}>Check my app against it</a></p>
  </section>

  <details class="sure" data-pagefind-ignore>
    <summary>How sure are we?</summary>
    <dl class="glance">
      <div><dt>confidence</dt><dd><span class={`badge ${e.confidence}`}>{e.confidence}</span> — {trustWhy.split(': ')[1]}</dd></div>
      {tier?.total > 0 && <div><dt>track record at this confidence</dt><dd><a href={href('scorecard/')} title={`${tier.held} held · ${tier.weakened} weakened · ${tier.overturned} overturned`}>{tier.score != null && tier.resolved >= 3 ? `${tier.score}% held up` : 'too early to score'}, {tier.resolved} of {tier.total} graded</a></dd></div>}
      {tr && <div><dt>this pick, graded</dt><dd><span class={`badge ${tr}`}>{tr}</span></dd></div>}
      <div><dt>depth</dt><dd><span class={`badge ${e.status}`}>{e.status}</span> — {e.status === 'reviewed' ? 'checked against primary sources, with a long-form explanation' : 'internally consistent and cited'}</dd></div>
      <div><dt>evidence</dt><dd>{nSources} source{nSources === 1 ? '' : 's'} · {nReading} reading{nReading === 1 ? '' : 's'}{nWatching ? ` · ${nWatching} talk${nWatching === 1 ? '' : 's'}` : ''}</dd></div>
      {e.updated && <div><dt>last checked</dt><dd>{age == null ? String(e.updated) : age === 0 ? 'on build day' : `${age} day${age === 1 ? '' : 's'} before this build`}{revs.length > 1 && <Fragment> · <a href={href('changelog/')} title={`entry file changed on: ${revs.join(', ')}`}>re-checked {revs.length}×</a></Fragment>}</dd></div>}
    </dl>
    <p class="meta"><a href={href('methodology/')}>how we check →</a></p>
  </details>

  <nav class={`toc${doc ? ' toc-sticky' : ''}`} aria-label="On this page" data-pagefind-ignore>
    {toc.map(([tid, label]) => <a href={`#${tid}`}>{label}</a>)}
  </nav>

  <h2 id="options" class="anc"><a class="h-anchor" data-pagefind-ignore href="#options" aria-label="Copy link to Options compared">#</a>Options compared</h2>
  <p class="meta lede">what else we looked at, and the tradeoff of each</p>
  <div class="tbl"><table class="opts">
    <thead><tr><th scope="col">option</th><th scope="col">tradeoff</th>{hasEvidence && <th scope="col">evidence</th>}</tr></thead>
    <tbody>{(e.options || []).map((o, i) => (
      <tr class={o === lead ? 'is-lead' : undefined}>
        <th scope="row" data-label="option">{o.name}{o === lead && <span class="lead-mark meta"> · our pick</span>}</th>
        <td data-label="tradeoff">{o.tradeoff}</td>
        {hasEvidence && <td data-label="evidence" class="meta ev">{evText(optEvidence[i])}</td>}
      </tr>
    ))}</tbody>
  </table></div>
  {hasEvidence && <p class="meta foot">evidence: npm weekly downloads (<a href={href('libraries/')}>signals snapshot</a>) · “ships in n/D” = adoption across the <a href={href('census/')}>production-app census</a>, honest denominators</p>}
  {pkgs.length > 0 && (
    <p class="meta foot">npm weekly downloads (last signals run): {pkgs.map((d, i) => <span>{i > 0 && ' · '}<code>{d.pkg}</code> {fmtDownloads(dl[d.pkg])}</span>)}</p>
  )}

  {e.migrate?.length > 0 && (
    <>
      <h2 id="migrate" class="anc"><a class="h-anchor" data-pagefind-ignore href="#migrate" aria-label="Copy link to Upgrade path">#</a>Upgrade path</h2>
      <p class="meta lede">versions and packages to move off — for your app's own ordered plan: <a href={href('doctor/')}>check my app</a> or <code>npx -y @heart-it/react-brain migrate .</code></p>
      <div class="rows">
        {e.migrate.map((r) => (
          <div>
            <p class="mig-line"><strong>{r.from.pkg}{r.from.below ? ` < ${r.from.below}` : ''}</strong> → {r.to}
              <span class="meta"> [{urgencyLabel(r.urgency)} · effort {r.effort}]</span></p>
            <p class="muted small">{r.why}</p>
            {r.receipts?.length > 0 && <p class="meta receipts">{r.receipts.map((u, i) => (
              <>{i > 0 && ' · '}<a href={u} rel="noopener">{srcLabel(u)}</a></>
            ))}</p>}
          </div>
        ))}
      </div>
    </>
  )}

  {(e.note || nSources > 0) && (
    <>
      <h2 id="notes" class="anc"><a class="h-anchor" data-pagefind-ignore href="#notes" aria-label="Copy link to Key facts">#</a>Key facts</h2>
      {e.note && <div class="prose notes">{paragraphs(e.note).map((p) => <p>{p}</p>)}</div>}
      {nSources > 0 && (
        <div class="sources" id="sources">
          <p class="rec-sub">sources</p>
          <p class="meta src-note">each link fetched and checked on {String(e.updated)}</p>
          <ul>{e.sources.map((s) => (
            <li><span class="src-type">{sourceType(s)}</span><a href={s} rel="noopener">{srcLabel(s)}</a></li>
          ))}</ul>
        </div>
      )}
      {e.defer_to_skill && <p class="muted small">This page helps you choose; the <code>{e.defer_to_skill}</code> skill covers how to use it well.</p>}
    </>
  )}

  {nReading > 0 && (
    <>
      <h2 id="reading" class="anc"><a class="h-anchor" data-pagefind-ignore href="#reading" aria-label="Copy link to Read more">#</a>Read more</h2>
      <p class="meta lede">why each piece is worth your time — the links go to the originals</p>
      <div class="rows">
        {e.reading.map((r) => (
          <div>
            <a class="item-title" href={r.url} rel="noopener"><strong>{r.title}</strong></a>
            {r.by && <span class="meta by">{r.by}</span>}
            <p class="muted small">{r.what}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {nWatching > 0 && (
    <>
      <h2 id="watching" class="anc"><a class="h-anchor" data-pagefind-ignore href="#watching" aria-label="Copy link to Watch">#</a>Watch</h2>
      <p class="meta lede">talks, podcasts and videos</p>
      <div class="rows">
        {e.watching.map((w) => (
          <div>
            <a class="item-title" href={w.url} rel="noopener"><strong>{w.title}</strong></a>
            {w.by && <span class="meta by">{w.by}</span>}
            <p class="muted small">{w.what}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {doc && (
    <>
      <h2 id="explanation" class="anc"><a class="h-anchor" data-pagefind-ignore href="#explanation" aria-label="Copy link to The full story">#</a>The full story</h2>
      <details class="essay-wrap" id="essay-wrap">
        <summary data-pagefind-ignore>Read why · ≈{docMinutes} min</summary>
        <p class="meta lede">the long-form reasoning behind this pick — the <em>why</em>, not a how-to · also on <a href={`${GITHUB}/blob/main/encyclopedia/${e.doc}`} rel="noopener">GitHub</a></p>
        <article class="prose essay" set:html={doc} />
      </details>
    </>
  )}

  {rels.length > 0 && (
    <>
      <h2 id="related" class="anc"><a class="h-anchor" data-pagefind-ignore href="#related" aria-label="Copy link to Related topics">#</a>Related topics</h2>
      <ul class="related">
        {rels.map(({ entry: x, labels }) => (
          <li><a href={href(`entries/${x.slug}/`)}>{x.topic}</a><span class="rel-label meta">{labels.map((l) => REL_LABEL[l] || l).join(' · ')}</span></li>
        ))}
      </ul>
    </>
  )}

  <nav class="pager" aria-label="Previous and next topic" data-pagefind-ignore>
    {prev ? <a class="prev" href={href(`entries/${prev.slug}/`)} rel="prev"><span class="meta">← previous{prev.group !== e.group ? ` · ${groupLabel(groupOf(prev))}` : ''}</span><span class="pg-title">{prev.topic}</span></a> : <span />}
    {next ? <a class="next" href={href(`entries/${next.slug}/`)} rel="next"><span class="meta">next{next.group !== e.group ? ` · ${groupLabel(groupOf(next))}` : ''} →</span><span class="pg-title">{next.topic}</span></a> : <span />}
  </nav>
  <p class="sr-only" id="copy-status" aria-live="polite" data-pagefind-ignore></p>

  <script>
    // The saved project (lib/project.js): when it uses a library this topic covers,
    // say how that choice sits against our pick — same fit rule as Check my app.
    import { load, fitOf } from '../../lib/project.js';
    import { fit } from '../../lib/doctor-core.js';
    const el = document.getElementById('session-banner');
    const p = load();
    const mine = p?.byEntry?.[el.dataset.entry];
    if (mine) {
      const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const f = fitOf(fit({ def: el.dataset.def, when: JSON.parse(el.dataset.when || '[]') }, mine.tokens || []));
      const why = { 'mark-ok': '', 'mark-warn': ' — check the situation below is yours', 'mark-dim': ' — compare it with the options below' }[f.cls];
      el.innerHTML = `<span class="meta">your project <a href="${document.body.dataset.base}">${esc(p.name)}</a> uses</span> <b>${esc((mine.labels || []).join(', '))}</b> — ` +
        `<span class="${f.cls}">${esc(f.label)}</span><span class="meta">${why}</span>`;
      el.hidden = false;
    }
  </script>

  <script is:inline>
    // Copy-link anchors on section headings: click copies the section URL (the
    // link still navigates without JS). Clipboard can be denied — say so.
    const status = document.getElementById('copy-status');
    for (const a of document.querySelectorAll('h2.anc > .h-anchor')) {
      a.addEventListener('click', async (ev) => {
        ev.preventDefault();
        const url = location.href.split('#')[0] + a.getAttribute('href');
        history.replaceState(null, '', a.getAttribute('href'));
        a.parentElement.scrollIntoView({ block: 'start' });
        let msg;
        try { await navigator.clipboard.writeText(url); msg = 'link copied'; }
        catch { msg = 'copy failed'; }
        a.dataset.state = msg; status.textContent = msg;
        clearTimeout(a._t); a._t = setTimeout(() => { delete a.dataset.state; }, 1600);
      });
    }

    // The essay is collapsed by default (progressive disclosure). Anchors that point
    // at it or into it would land on nothing inside a closed <details>, so open it for
    // #explanation, any id inside it, links to #explanation (TOC, copy-link), and print.
    const wrap = document.getElementById('essay-wrap');
    if (wrap) {
      const reveal = (id, scroll) => {
        if (!id) return;
        const el = document.getElementById(id);
        if (!el || !(id === 'explanation' || wrap.contains(el))) return;
        wrap.open = true;
        if (scroll) el.scrollIntoView({ block: 'start' });
      };
      const fromHash = () => { try { return decodeURIComponent(location.hash.slice(1)); } catch { return location.hash.slice(1); } };
      reveal(fromHash(), true);
      addEventListener('hashchange', () => reveal(fromHash(), true));
      document.addEventListener('click', (ev) => {
        const a = ev.target.closest?.('a[href="#explanation"]');
        if (a) wrap.open = true;
      });
      addEventListener('beforeprint', () => { wrap.open = true; });
    }

    // Sticky mini-TOC (long pages only, ≥1024px via CSS): mark the section in view.
    const toc = document.querySelector('.toc-sticky');
    if (toc && 'IntersectionObserver' in window) {
      const links = new Map([...toc.querySelectorAll('a')].map((l) => [l.getAttribute('href').slice(1), l]));
      const io = new IntersectionObserver((xs) => {
        for (const x of xs) if (x.isIntersecting) {
          for (const l of links.values()) l.removeAttribute('aria-current');
          links.get(x.target.id)?.setAttribute('aria-current', 'location');
        }
      }, { rootMargin: '-20% 0px -70% 0px' });
      for (const id of links.keys()) { const h = document.getElementById(id); if (h) io.observe(h); }
      // a TOC jump can land a heading past the observed band without it ever
      // intersecting — mark the clicked section directly
      toc.addEventListener('click', (ev) => {
        const a = ev.target.closest('a'); if (!a) return;
        for (const l of links.values()) l.removeAttribute('aria-current');
        a.setAttribute('aria-current', 'location');
      });
    }
  </script>
</Base>

<style>
  /* "Internationalization" alone is wider than a 320px column */
  h1 { overflow-wrap: break-word; hyphens: auto; }
  .crumbs { margin: 0; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--fg); }
  .entry-meta { max-width: none; display: flex; flex-wrap: wrap; gap: .15rem 0; margin: .2rem 0 0; }
  .entry-meta > span:not(:last-child)::after { content: "·"; margin: 0 .55rem; color: var(--line-strong); }
  .entry-meta a { color: var(--muted); }
  .entry-meta a:hover { color: var(--accent); }

  /* the page's one visual anchor: the answer */
  .rec-panel { margin: 1.4rem 0 0; padding: 1.15rem 1.3rem 1.2rem; background: var(--card); border: 1px solid var(--line-strong); border-left: 3px solid var(--ok); border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised); }   /* the green rule is the anchor; glow is reserved for the hero terminal */
  .rec-label, .rec-sub { font: 500 var(--fs-xs)/1.5 var(--font-mono); margin: 0; }
  .rec-label { color: var(--ok); }
  .rec-label::before { content: "❯ "; }
  .rec-sub { color: var(--muted); margin-top: 1rem; }
  .rec-default { margin: .45rem 0 0; color: var(--bright); font-size: var(--fs-lg); line-height: 1.6; max-width: var(--measure); }
  .rec-when { list-style: none; padding: 0; margin: .4rem 0 0; max-width: var(--measure); }
  .rec-when li { margin: 0; padding: .45rem 0 .45rem .9rem; border-top: 1px solid var(--line); font-size: var(--fs-sm); max-width: var(--measure); position: relative; }
  .rec-when li::before { content: ""; position: absolute; left: 0; top: .95rem; width: .35rem; height: 1px; background: var(--line-strong); }
  .rec-when .ctx { color: var(--muted); }
  .rec-when .arrow { color: var(--accent); font-family: var(--font-mono); }
  .rec-when .pick { color: var(--fg); }
  .rec-caveat { margin: 1rem 0 0; padding-top: .7rem; border-top: 1px dashed var(--line-strong); color: var(--muted); font-size: var(--fs-sm); max-width: var(--measure); }
  .rec-caveat strong { color: var(--warn); }

  .session { margin: var(--sp-4) 0 0; padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm); background: var(--card); border-left: 2px solid var(--accent); border-radius: var(--radius-sm); overflow-wrap: anywhere; }
  .entry-meta .badge { font-weight: 600; }
  .sure { margin: var(--sp-4) 0 0; }
  .sure > summary { cursor: pointer; min-height: 24px; padding-block: var(--sp-1); font: 500 var(--fs-xs)/1.5 var(--font-mono); color: var(--muted); width: fit-content; }
  .sure > summary:hover { color: var(--fg); }
  .sure .meta { margin: var(--sp-2) 0 0; }

  /* at a glance: four facts on hairlines, no boxes */
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .2rem 1.4rem; margin: 1.1rem 0 0; }
  .glance > div { border-top: 1px solid var(--line); padding: .5rem 0 0; min-width: 0; }
  .glance dt { font: 500 var(--fs-xs)/1.4 var(--font-mono); color: var(--muted); }
  .glance dd { margin: .15rem 0 0; font-size: var(--fs-sm); color: var(--fg); overflow-wrap: anywhere; }

  .toc { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin: 1.3rem 0 0; font: 400 var(--fs-xs)/1.5 var(--font-mono); }
  .toc a { color: var(--muted); text-decoration: none; padding: var(--sp-1) 0; }   /* ≥ 24px tall */
  /* reading/watching titles are the row's target: pad them to ≥ 24px without moving the text */
  .item-title { display: inline-block; padding-block: var(--sp-1); margin-block: calc(-1 * var(--sp-1)); }
  .toc a:hover, .toc a[aria-current] { color: var(--accent); }
  @media (min-width: 1024px) {
    .toc-sticky { position: sticky; top: var(--header-h); z-index: 3; margin-inline: -28px; padding: .45rem 28px; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); }
  }
  h2[id] { scroll-margin-top: calc(var(--header-h) + 3.2rem); }
  #sources { scroll-margin-top: calc(var(--header-h) + 3.2rem); }

  /* heading copy-link: the "#" prefix IS the link */
  :global(main) h2.anc::before { content: none; }
  /* inline-block so the "#" is a ≥24px target without changing the heading's look */
  .h-anchor { display: inline-block; min-width: 24px; min-height: 24px; text-align: center; color: var(--accent); font-weight: 400; text-decoration: none; margin-inline-end: var(--sp-1); position: relative; border-radius: 3px; }
  .h-anchor:hover, .h-anchor:focus-visible { color: var(--bright); }
  /* tooltip sits below the "#" — above it, the sticky header/TOC would cover it */
  .h-anchor::after { content: "copy link"; position: absolute; inset-inline-start: 0; top: calc(100% + 2px); z-index: 2; white-space: nowrap; font: 400 var(--fs-xs)/1.5 var(--font-mono); color: var(--muted); background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: .05rem .4rem; opacity: 0; pointer-events: none; transition: opacity .12s; }
  .h-anchor:hover::after, .h-anchor:focus-visible::after { opacity: 1; }
  .h-anchor[data-state]::after { content: attr(data-state); opacity: 1; color: var(--fg); }
