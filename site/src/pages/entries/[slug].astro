---
// One decision page. Reading order is the decision itself, answer first:
// breadcrumb → h1 → one metadata line → THE recommendation panel (the page's single
// visual anchor) → at-a-glance strip → options → migration lines → verified notes +
// sources → reading → watching → full explanation → related decisions → prev/next.
import Base from '../../layouts/Base.astro';
import { corpus, downloads, fmtDownloads, track, docHtml, href, GITHUB, census, revisions, scorecard, siteMeta } from '../../lib/corpus.js';
import { srcLabel, sourceType, relations, prevNext, groupOf, groupLabel, leadOption, clip, splitWhen, paragraphs, ageDays } from '../../lib/entry.js';

export function getStaticPaths() {
  return corpus().entries.map((e) => ({ params: { slug: e.slug }, props: { id: e.id } }));
}
const { id } = Astro.props;
const { byId } = corpus();
const e = byId[id];
const meta = siteMeta();
const dl = downloads();
const tr = track()[id];
const pkgs = (e.detect || []).filter((d) => !d.pkg.includes('*') && dl[d.pkg] != null);
const doc = docHtml(e);
const group = groupOf(e);
const rels = relations(e);
const { prev, next } = prevNext(e);
// calibration: what this confidence tier has actually earned on the public scorecard
const tier = scorecard()?.tiers?.[e.confidence];
// verification history: the dates this entry's file changed in git
const revs = revisions(id);
const when = e.recommend?.when || [];
const lead = leadOption(e);
const age = ageDays(e.updated, meta.built);
const nSources = e.sources?.length || 0, nReading = e.reading?.length || 0, nWatching = e.watching?.length || 0;

// per-option evidence: map option → detect label (fuzzy) → census adoption + npm downloads
const cen = census();
const agg = cen?.agg?.[id] || null;
const optEvidence = (e.options || []).map((o) => {
  const on = o.name.toLowerCase().replace(/\s*\(.*/, '');
  const d = (e.detect || []).find((x) => {
    const l = x.label.toLowerCase().replace(/\s*\(.*/, '');
    return l.length > 2 && (on.includes(l) || l.includes(on));
  });
  if (!d) return null;
  const ships = agg?.labels?.[d.label] ?? null;
  const wk = !d.pkg.includes('*') ? (dl[d.pkg] ?? null) : null;
  return ships != null || wk != null ? { ships, denom: agg?.denom ?? null, wk } : null;
});
const hasEvidence = optEvidence.some(Boolean);
const evText = (ev) => ev ? [
  ev.wk != null ? `${fmtDownloads(ev.wk)}/wk` : null,
  ev.ships != null ? `ships in ${ev.ships}/${ev.denom}` : null,
].filter(Boolean).join(' · ') : '';

const toc = [
  ['options', 'Options'],
  e.migrate?.length ? ['migrate', 'Migration'] : null,
  e.note || nSources ? ['notes', 'Notes & sources'] : null,
  nReading ? ['reading', 'Reading'] : null,
  nWatching ? ['watching', 'Watching'] : null,
  doc ? ['explanation', 'Explanation'] : null,
  rels.length ? ['related', 'Related'] : null,
].filter(Boolean);
---
<Base title={e.topic} description={`${e.topic} — ${clip(e.recommend?.default, 150)}`} activeGroup={e.group}>
  <nav class="crumbs meta" aria-label="Breadcrumb">
    <a href={href('entries/')}>Explore</a><span aria-hidden="true"> › </span><a href={href(`entries/#${e.group}`)}>{groupLabel(group).toLowerCase() || e.group}</a><span aria-hidden="true"> › </span><span aria-current="page">{e.slug}</span>
  </nav>
  <h1>{e.topic}</h1>
  <p class="meta entry-meta">
    <span><span class={`badge ${e.status}`}>{e.status}</span></span>
    <span>confidence <span class={`badge ${e.confidence}`}>{e.confidence}</span>{tier?.total > 0 && (
      <a href={href('scorecard/')} title={`${e.confidence}-confidence forecasts on the public scorecard: ${tier.held} held · ${tier.weakened} weakened · ${tier.overturned} overturned`}> ({tier.score != null && tier.resolved >= 3 ? `tier ${tier.score}%, ` : tier.resolved ? 'early: ' : ''}{tier.resolved}/{tier.total} graded)</a>
    )}</span>
    {tr && <span>forecast <span class={`badge ${tr}`}>{tr}</span></span>}
    {e.platforms?.length > 0 && <span>{e.platforms.join(' + ')}</span>}
    {e.updated && <span>verified <time datetime={String(e.updated)}>{String(e.updated)}</time></span>}
    {revs.length > 1 && <span><a href={href('changelog/')} title={`entry file changed on: ${revs.join(', ')}`}>re-verified {revs.length}×</a></span>}
  </p>

  <section class="rec-panel" aria-labelledby="rec-label">
    <p class="rec-label" id="rec-label">recommendation</p>
    <p class="rec-default">{e.recommend?.default}</p>
    {when.length > 0 && (
      <>
        <p class="rec-sub">when your context differs</p>
        <ul class="rec-when">
          {when.map((w) => { const { ctx, pick } = splitWhen(w); return (
            <li>{ctx ? <><span class="ctx">{ctx}</span> <span class="arrow" aria-hidden="true">→</span><span class="sr-only">: use</span> <span class="pick">{pick}</span></> : <span class="pick">{pick}</span>}</li>
          ); })}
        </ul>
      </>
    )}
    {e.confidence === 'low' && (
      <p class="rec-caveat"><strong>Low confidence</strong> — fast-moving or lightly-vetted domain: treat the pick as a vetted lead and prototype before committing.</p>
    )}
  </section>

  <div id="session-banner" class="session" hidden></div>

  <dl class="glance" aria-label="At a glance">
    {lead && <div><dt>lead option</dt><dd>{lead.name}</dd></div>}
    {lead?.tradeoff && <div><dt>its tradeoff</dt><dd title={lead.tradeoff}>{clip(lead.tradeoff, 110)}</dd></div>}
    <div><dt>evidence</dt><dd>{nSources} source{nSources === 1 ? '' : 's'} · {nReading} reading{nReading === 1 ? '' : 's'}{nWatching ? ` · ${nWatching} talk${nWatching === 1 ? '' : 's'}` : ''}</dd></div>
    {e.updated && <div><dt>freshness</dt><dd>{age == null ? String(e.updated) : age === 0 ? 'verified on build day' : `verified ${age} day${age === 1 ? '' : 's'} before this build`}</dd></div>}
  </dl>

  <nav class={`toc${doc ? ' toc-sticky' : ''}`} aria-label="On this page">
    {toc.map(([tid, label]) => <a href={`#${tid}`}>{label}</a>)}
  </nav>

  <h2 id="options" class="anc"><a class="h-anchor" href="#options" aria-label="Copy link to Options and tradeoffs">#</a>Options &amp; tradeoffs</h2>
  <p class="meta lede">the field considered — and why each one isn’t the default here</p>
  <div class="tbl"><table class="opts">
    <thead><tr><th scope="col">option</th><th scope="col">tradeoff</th>{hasEvidence && <th scope="col">evidence</th>}</tr></thead>
    <tbody>{(e.options || []).map((o, i) => (
      <tr class={o === lead ? 'is-lead' : undefined}>
        <th scope="row" data-label="option">{o.name}{o === lead && <span class="lead-mark meta"> · lead</span>}</th>
        <td data-label="tradeoff">{o.tradeoff}</td>
        {hasEvidence && <td data-label="evidence" class="meta ev">{evText(optEvidence[i])}</td>}
      </tr>
    ))}</tbody>
  </table></div>
  {hasEvidence && <p class="meta foot">evidence: npm weekly downloads (<a href={href('libraries/')}>signals snapshot</a>) · “ships in n/D” = adoption across the <a href={href('census/')}>production-app census</a>, honest denominators</p>}
  {pkgs.length > 0 && (
    <p class="meta foot">npm weekly downloads (last signals run): {pkgs.map((d, i) => <span>{i > 0 && ' · '}<code>{d.pkg}</code> {fmtDownloads(dl[d.pkg])}</span>)}</p>
  )}

  {e.migrate?.length > 0 && (
    <>
      <h2 id="migrate" class="anc"><a class="h-anchor" href="#migrate" aria-label="Copy link to Migration lines">#</a>Migration lines</h2>
      <p class="meta lede">version and deprecation lines this decision tracks — for YOUR repo's sequenced plan: <a href={href('doctor/')}>the doctor</a> or <code>npx -y @heart-it/react-brain migrate .</code></p>
      <div class="rows">
        {e.migrate.map((r) => (
          <div>
            <p style="margin:0"><strong>{r.from.pkg}{r.from.below ? ` < ${r.from.below}` : ''}</strong> → {r.to}
              <span class="meta"> [{r.urgency} · effort {r.effort}]</span></p>
            <p class="muted small">{r.why}</p>
            {r.receipts?.length > 0 && <p class="meta" style="margin:.25rem 0 0">{r.receipts.map((u, i) => (
              <>{i > 0 && ' · '}<a href={u} rel="noopener">{srcLabel(u)}</a></>
            ))}</p>}
          </div>
        ))}
      </div>
    </>
  )}

  {(e.note || nSources > 0) && (
    <>
      <h2 id="notes" class="anc"><a class="h-anchor" href="#notes" aria-label="Copy link to Verified notes">#</a>Verified notes</h2>
      {e.note && <div class="prose notes">{paragraphs(e.note).map((p) => <p>{p}</p>)}</div>}
      {nSources > 0 && (
        <div class="sources" id="sources">
          <p class="rec-sub">sources for this entry</p>
          <p class="meta" style="margin:0 0 .4rem">fetch-verified as of {String(e.updated)} · type is inferred from the URL</p>
          <ul>{e.sources.map((s) => (
            <li><span class="src-type">{sourceType(s)}</span><a href={s} rel="noopener">{srcLabel(s)}</a></li>
          ))}</ul>
        </div>
      )}
      {e.defer_to_skill && <p class="muted small">Depth (in-domain rules) is owned by the <code>{e.defer_to_skill}</code> skill — this entry is selection breadth.</p>}
    </>
  )}

  {nReading > 0 && (
    <>
      <h2 id="reading" class="anc"><a class="h-anchor" href="#reading" aria-label="Copy link to Canonical reading">#</a>Canonical reading</h2>
      <p class="meta lede">editorial annotations on why each piece matters — the articles are the originals; read them there</p>
      <div class="rows">
        {e.reading.map((r) => (
          <div>
            <a href={r.url} rel="noopener"><strong>{r.title}</strong></a>
            {r.by && <span class="meta" style="margin-left:.5rem">{r.by}</span>}
            <p class="muted small">{r.what}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {nWatching > 0 && (
    <>
      <h2 id="watching" class="anc"><a class="h-anchor" href="#watching" aria-label="Copy link to Watching">#</a>Watching</h2>
      <p class="meta lede">curated talks, podcasts &amp; videos — the A/V companion to the reading list</p>
      <div class="rows">
        {e.watching.map((w) => (
          <div>
            <a href={w.url} rel="noopener"><strong>{w.title}</strong></a>
            {w.by && <span class="meta" style="margin-left:.5rem">{w.by}</span>}
            <p class="muted small">{w.what}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {doc && (
    <>
      <h2 id="explanation" class="anc"><a class="h-anchor" href="#explanation" aria-label="Copy link to The full explanation">#</a>The full explanation</h2>
      <p class="meta lede">the reviewed long-form essay behind this entry — the <em>why</em>, not a how-to · also on <a href={`${GITHUB}/blob/main/encyclopedia/${e.doc}`} rel="noopener">GitHub</a></p>
      <article class="prose" set:html={doc} />
    </>
  )}

  {rels.length > 0 && (
    <>
      <h2 id="related" class="anc"><a class="h-anchor" href="#related" aria-label="Copy link to Related decisions">#</a>Related decisions</h2>
      <p class="meta lede"><b>cited here</b> = this entry's text names it · <b>cites this</b> = its text names this entry · <b>same group</b> = sibling in {groupLabel(group).toLowerCase() || e.group}</p>
      <ul class="related">
        {rels.map(({ entry: x, labels }) => (
          <li><a href={href(`entries/${x.slug}/`)}>{x.slug}</a><span class="rel-topic">{x.topic}</span><span class="rel-label meta">{labels.join(' · ')}</span></li>
        ))}
      </ul>
    </>
  )}

  <nav class="pager" aria-label="Previous and next decision">
    {prev ? <a class="prev" href={href(`entries/${prev.slug}/`)} rel="prev"><span class="meta">← previous{prev.group !== e.group ? ` · ${groupLabel(groupOf(prev)).toLowerCase()}` : ''}</span><span class="pg-title">{prev.topic}</span></a> : <span />}
    {next ? <a class="next" href={href(`entries/${next.slug}/`)} rel="next"><span class="meta">next{next.group !== e.group ? ` · ${groupLabel(groupOf(next)).toLowerCase()}` : ''} →</span><span class="pg-title">{next.topic}</span></a> : <span />}
  </nav>
  <p class="sr-only" id="copy-status" aria-live="polite"></p>

  <script is:inline define:vars={{ entryId: e.id, def: e.recommend?.default || '', when }}>
    // Session context: a repo loaded with the console's `load` (⌘J) is kept in
    // localStorage; when it uses a library this decision covers, say how that
    // choice sits against the recommendation (same fit rule as the console).
    try {
      const ctx = JSON.parse(localStorage.getItem('rb-console-ctx'));
      const mine = ctx?.byEntry?.[entryId];
      if (mine) {
        const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const tokens = mine.tokens || [];
        const d = def.toLowerCase(), w = when.join('||').toLowerCase();
        const [fit, cls, why] = tokens.some((x) => d.includes(x)) ? ['✓ aligned', 't-ok', 'matches the default']
          : tokens.some((x) => w.includes(x)) ? ['~ contextual', 't-warn', 'matches a when-clause — check the context fits']
          : ['↗ review', 'muted', 'not named in the recommendation — compare against the options'];
        const el = document.getElementById('session-banner');
        el.innerHTML = `<span class="meta">your repo ~/${esc(ctx.name)} uses</span> <b>${esc((mine.labels || []).join(', '))}</b> here — <span class="${cls}">${fit}</span> <span class="meta">(${why}) · loaded via the console · <button type="button" class="linkish" data-clear-ctx>forget</button></span>`;
        el.hidden = false;
        el.querySelector('[data-clear-ctx]').addEventListener('click', () => { try { localStorage.removeItem('rb-console-ctx'); } catch {} el.hidden = true; });
      }
    } catch {}

    // Copy-link anchors on section headings: click copies the section URL (the
    // link still navigates without JS). Clipboard can be denied — say so.
    const status = document.getElementById('copy-status');
    for (const a of document.querySelectorAll('h2.anc > .h-anchor')) {
      a.addEventListener('click', async (ev) => {
        ev.preventDefault();
        const url = location.href.split('#')[0] + a.getAttribute('href');
        history.replaceState(null, '', a.getAttribute('href'));
        a.parentElement.scrollIntoView({ block: 'start' });
        let msg;
        try { await navigator.clipboard.writeText(url); msg = 'link copied'; }
        catch { msg = 'copy failed'; }
        a.dataset.state = msg; status.textContent = msg;
        clearTimeout(a._t); a._t = setTimeout(() => { delete a.dataset.state; }, 1600);
      });
    }

    // Sticky mini-TOC (long pages only, ≥1024px via CSS): mark the section in view.
    const toc = document.querySelector('.toc-sticky');
    if (toc && 'IntersectionObserver' in window) {
      const links = new Map([...toc.querySelectorAll('a')].map((l) => [l.getAttribute('href').slice(1), l]));
      const io = new IntersectionObserver((xs) => {
        for (const x of xs) if (x.isIntersecting) {
          for (const l of links.values()) l.removeAttribute('aria-current');
          links.get(x.target.id)?.setAttribute('aria-current', 'location');
        }
      }, { rootMargin: '-20% 0px -70% 0px' });
      for (const id of links.keys()) { const h = document.getElementById(id); if (h) io.observe(h); }
    }
  </script>
</Base>

<style>
  .crumbs { margin: 0; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--fg); }
  .entry-meta { display: flex; flex-wrap: wrap; gap: .15rem 0; margin: .2rem 0 0; }
  .entry-meta > span:not(:last-child)::after { content: "·"; margin: 0 .55rem; color: var(--line-strong); }
  .entry-meta a { color: var(--muted); }
  .entry-meta a:hover { color: var(--accent); }

  /* the page's one visual anchor: the answer */
  .rec-panel { margin: 1.4rem 0 0; padding: 1.15rem 1.3rem 1.2rem; background: var(--card); border: 1px solid var(--line-strong); border-left: 3px solid var(--ok); border-radius: 8px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 0 60px -30px rgba(80,250,123,.45); }
  .rec-label, .rec-sub { font: 500 .78rem/1.5 var(--font-mono); margin: 0; }
  .rec-label { color: var(--ok); }
  .rec-label::before { content: "❯ "; }
  .rec-sub { color: var(--muted); margin-top: 1rem; }
  .rec-default { margin: .45rem 0 0; color: var(--bright); font-size: 1.08rem; line-height: 1.6; max-width: 72ch; }
  .rec-when { list-style: none; padding: 0; margin: .4rem 0 0; max-width: 78ch; }
  .rec-when li { margin: 0; padding: .45rem 0 .45rem .9rem; border-top: 1px solid var(--line); font-size: .93rem; position: relative; }
  .rec-when li::before { content: ""; position: absolute; left: 0; top: .95rem; width: .35rem; height: 1px; background: var(--line-strong); }
  .rec-when .ctx { color: var(--muted); }
  .rec-when .arrow { color: var(--accent); font-family: var(--font-mono); }
  .rec-when .pick { color: var(--fg); }
  .rec-caveat { margin: 1rem 0 0; padding-top: .7rem; border-top: 1px dashed var(--line-strong); color: var(--muted); font-size: .9rem; }
  .rec-caveat strong { color: var(--warn); }

  .session { margin: .7rem 0 0; font-size: .9rem; }
  .session :global(.linkish) { background: none; border: 0; box-shadow: none; padding: 0; color: var(--accent); font: inherit; text-decoration: underline; cursor: pointer; }
  .session :global(.linkish:hover) { transform: none; background: none; box-shadow: none; }

  /* at a glance: four facts on hairlines, no boxes */
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .2rem 1.4rem; margin: 1.1rem 0 0; }
  .glance > div { border-top: 1px solid var(--line); padding: .5rem 0 0; min-width: 0; }
  .glance dt { font: 500 .72rem/1.4 var(--font-mono); color: var(--muted); }
  .glance dd { margin: .15rem 0 0; font-size: .88rem; color: var(--fg); overflow-wrap: anywhere; }

  .toc { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin: 1.3rem 0 0; font: 400 .8rem/1.5 var(--font-mono); }
  .toc a { color: var(--muted); text-decoration: none; padding: .15rem 0; }
  .toc a:hover, .toc a[aria-current] { color: var(--accent); }
  @media (min-width: 1024px) {
    .toc-sticky { position: sticky; top: var(--header-h); z-index: 3; margin-inline: -28px; padding: .45rem 28px; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); }
  }
  h2[id] { scroll-margin-top: calc(var(--header-h) + 3.2rem); }
  #sources { scroll-margin-top: calc(var(--header-h) + 3.2rem); }

  /* heading copy-link: the "#" prefix IS the link */
  :global(main) h2.anc::before { content: none; }
  .h-anchor { color: var(--accent); font-weight: 400; text-decoration: none; margin-right: .5rem; position: relative; border-radius: 3px; }
  .h-anchor:hover, .h-anchor:focus-visible { color: var(--bright); }
  .h-anchor::after { content: "copy link"; position: absolute; left: 0; bottom: 100%; white-space: nowrap; font: 400 .7rem var(--font-mono); color: var(--muted); background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: .05rem .4rem; opacity: 0; pointer-events: none; transition: opacity .12s; }
  .h-anchor:hover::after, .h-anchor:focus-visible::after { opacity: 1; }
  .h-anchor[data-state]::after { content: attr(data-state); opacity: 1; color: var(--fg); }
  .h-anchor[data-state="copy failed"]::after { color: var(--bad); }

  .lede { margin: -.35rem 0 .6rem; }
  .foot { margin: .4rem 0 0; }
  .small { margin: .3rem 0 0; font-size: .88rem; max-width: 78ch; }

  .opts th[scope="row"] { font: 600 .9rem/1.5 var(--font-body); color: var(--bright); padding-right: 1rem; min-width: 9rem; }
  .opts .lead-mark { color: var(--ok); font-weight: 400; }
  .opts tr.is-lead th[scope="row"] { box-shadow: inset 2px 0 0 var(--ok); padding-left: .6rem; }
  .opts .ev { white-space: nowrap; }
  /* ≤600px: each option becomes a stacked block — name, tradeoff, evidence */
  @media (max-width: 600px) {
    .opts, .opts tbody, .opts tr, .opts th[scope="row"], .opts td { display: block; width: 100%; }
    .opts thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .opts tr { border-bottom: 1px solid var(--line); padding: .6rem 0; }
    .opts th[scope="row"], .opts td { border: 0; padding: .1rem 0; min-width: 0; }
    .opts tr.is-lead th[scope="row"] { padding-left: .6rem; }
    .opts .ev { white-space: normal; }
    .opts .ev:empty { display: none; }
    .opts .ev:not(:empty)::before { content: attr(data-label) ": "; }
  }

  .notes p { margin: 0 0 .9rem; }
  .sources { margin: 1.2rem 0 0; padding-top: .2rem; }
  .sources ul { list-style: none; padding: 0; margin: 0; }
  .sources li { display: flex; gap: .7rem; align-items: baseline; margin: 0; padding: .3rem 0; border-top: 1px solid var(--line); font-size: .88rem; min-width: 0; }
  .sources li a { overflow-wrap: anywhere; min-width: 0; }
  .src-type { flex: 0 0 6.6rem; font: 400 .74rem var(--font-mono); color: var(--muted); }

  .related { list-style: none; padding: 0; margin: 0; }
  .related li { display: grid; grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr) auto; gap: .2rem 1rem; align-items: baseline; margin: 0; padding: .5rem 0; border-top: 1px solid var(--line); }
  .related li a { font: 600 .9rem var(--font-head); text-decoration: none; }
  .rel-topic { color: var(--muted); font-size: .88rem; }
  .rel-label { text-align: right; white-space: nowrap; }
  @media (max-width: 600px) {
    .related li { grid-template-columns: minmax(0, 1fr); gap: .1rem; }
    .rel-label { text-align: left; white-space: normal; }
  }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 3rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: .15rem; text-decoration: none; min-width: 0; }
  .pager .next { text-align: right; }
  .pg-title { color: var(--fg); font-size: .92rem; }
  .pager a:hover .pg-title { color: var(--accent); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
